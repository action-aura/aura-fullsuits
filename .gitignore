# Environments / secrets
.env
.env.*
!.env.*.example
*.local.env
android/*/keystore.properties
android/*/local.properties
*.jks
*.keystore

# Python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/
.pytest_cache/

# Databases (dev artifacts — never ship real customer data)
*.db
*.sqlite
*.sqlite3
!products/*/database/schema.py
!products/*/database/seed.py

# Node / web tooling (owner dashboard frontend)
node_modules/
/dist/
/build/
.venv_test/

# Windows PyInstaller build outputs (never commit built exes -- see docs/release/wave1b)
products/*/packaging/dist/

# Android (two independent projects: android/aura-retail, android/aura-clinic)
android/*/.gradle/
android/*/app/build/
android/*/build/
android/*/local.properties
android/*/.idea/
*.iml
android/*/.cxx/
# APK/AAB build outputs are not committed by policy -- see docs/android/*
android/*/app/build/outputs/

# Audit-only temp artifacts (Phase 3.5) -- never committed, ephemeral only
.audit-temp/

# Aura Owner -- PostgreSQL backup artifacts (Phase 5, Part Y) -- never committed
owner/var/backups/
*.dump

# Aura Owner -- server signing private keys and simulator device private keys
# (Phase 6, Parts I/U) -- NEVER committed under any circumstances
owner/var/signing-keys/
owner/var/signing-keys-test/
*.pem

# Aura Owner -- private Expense attachment storage (Phase 9.5E) -- never
# committed, matches signing-keys' private-storage treatment above.
owner/var/expense-attachments/
owner/var/expense-attachments-test/
owner/tools/activation_simulator/.device/
owner/tools/activation_simulator/**/*.key

# Products -- per-install Flask secret key, auto-generated by
# commercial_runtime/security/app_secret.py on first run whenever a dev
# server/test suite runs without AURA_APP_DATA pointed elsewhere (falls back
# to writing into the backend source tree itself) -- NEVER committed.
products/*/backend/security/

# Phase 7 -- device-bound trust anchor is a deployment artifact generated by
# scripts/generate_trust_anchor.py against a REAL Owner instance's signing
# key; never a static file checked into source control.
commercial_runtime/licensing_contracts/trust_anchor.json

# OS/editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Logs
*.log
