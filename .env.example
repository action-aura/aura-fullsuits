# Aura FullSuits — environment template. Copy to .env and fill in real values.
# Never commit a real .env. No value below is a working secret.

# ── Shared ────────────────────────────────────────────────────────────────
AURA_ENVIRONMENT=development          # development | staging | production
AURA_STANDALONE=1                     # 1 for packaged customer builds (desktop/Android)

# ── Retail / Clinic product backends ────────────────────────────────────
# SECRET_KEY is NOT set here on purpose — each installation generates and
# persists its own via commercial_runtime/security/app_secret.py.
AURA_APP_DATA=                        # override local app-data dir (dev only; leave empty for default)

# Per-device login / "one Admin Device" (commercial_runtime/identity/) --
# gates login enforcement by (user, device) grant, once wired up. Unset,
# empty, or "0" (the default) means OFF -- see
# commercial_runtime/identity/device_context.py's binding_enforced(). As of
# this writing the feature is backend-schema-only (devices/user_devices
# tables + read-only GET /api/devices, /api/devices/me visibility routes):
# this flag has NO CALLER yet, so setting it to a truthy value today has no
# effect on login behavior. See docs/superpowers/specs/2026-08-10-per-device-login.md.
AURA_DEVICE_BINDING_ENFORCED=          # 1/true/yes/on to enforce once wired; default off, currently a no-op

# ── Owner Control Center ────────────────────────────────────────────────
OWNER_DATABASE_URL=postgresql://aura_owner:CHANGE_ME@localhost:5432/aura_owner_dev
OWNER_SESSION_SECRET=CHANGE_ME_GENERATE_A_RANDOM_VALUE
OWNER_ALLOWED_CORS_ORIGINS=http://localhost:5173
OWNER_MFA_ENFORCED=false

# ── Client installation telemetry/update endpoints ──────────────────────
OWNER_SERVER_BASE_URL=https://owner.example.invalid
TELEMETRY_ENABLED=false               # disabled by default until consent flow ships
TELEMETRY_CHECKIN_INTERVAL_SECONDS=3600

# ── Deployment ───────────────────────────────────────────────────────────
POSTGRES_USER=aura_owner
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=aura_owner
