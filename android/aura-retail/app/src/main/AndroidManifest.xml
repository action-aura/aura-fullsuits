<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Needed to talk to the embedded server over the loopback socket. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Phone-camera barcode scanning in Aura POS (optional; requested at runtime). -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!--
      Needed to HEAR the shop hub's addressing beacon on the LAN.

      Android's wifi stack filters out packets that are not explicitly
      addressed to this device, broadcast included, so a plain
      DatagramSocket bound to the beacon port receives NOTHING no matter how
      correctly it is written. Measured, not assumed: with the hub confirmed
      broadcasting every 5s (a desktop listener on the same wifi heard it
      immediately), the phone's own listener reported "No hub beacon heard
      on this sweep" on every single tick.

      A normal (non-dangerous) permission, granted at install and never
      prompted for, and it does nothing on its own: it only makes
      WifiManager.createMulticastLock() usable, which HubTransport acquires
      solely for the few seconds of each beacon listen and always releases
      (see its own comment on the battery cost).
    -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <!--
      In-app updates (updates/ApkInstaller.kt): lets this app hand a downloaded,
      hash- and signer-checked APK to Android's PackageInstaller. Without it the
      session is refused outright. It is NOT a grant by itself: on API 26+ the
      user must still switch "Install unknown apps" on for this app, and the
      Updates card sends them to exactly that screen when it is off.
    -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <!--
      PRINT-2 receipt printing. Bluetooth: API 31+ asks BLUETOOTH_CONNECT at
      runtime (the Settings screen requests it when a Bluetooth printer is
      chosen); API 26-30 use the old normal permissions, so they are capped at
      maxSdkVersion 30 and cost nothing on a newer phone. No SCAN / location:
      printers are paired in Android Settings and listed from bonded devices.
      neverForLocation is not needed because BLUETOOTH_SCAN is not requested.
    -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-feature android:name="android.hardware.bluetooth" android:required="false" />
    <!-- USB printers over OTG; optional so the app still installs on phones without host mode. -->
    <uses-feature android:name="android.hardware.usb.host" android:required="false" />

    <!--
      Android 11+ package visibility: without this, the Sunmi printer service is
      invisible to resolveService() and the "Built-in printer" choice would never
      appear on a Sunmi terminal.
    -->
    <queries>
        <package android:name="woyou.aidlservice.jiuiv5" />
    </queries>

    <application
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Aura">

        <!-- BACKUP-1: lets the share sheet read ONE backup file we copy into
             cache/backup_share/ (see res/xml/backup_share_paths.xml). Not exported;
             access is granted per share through FLAG_GRANT_READ_URI_PERMISSION. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.backupshare"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/backup_share_paths" />
        </provider>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout|uiMode"
            android:label="@string/app_name"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Receives the PackageInstaller's progress and result. exported=false:
          the system reaches it through the PendingIntent this app created
          (which carries this app's own identity), so no other app can post a
          fake "install succeeded" or a fake confirm screen into it.
        -->
        <receiver
            android:name=".updates.InstallResultReceiver"
            android:exported="false" />
    </application>
</manifest>
