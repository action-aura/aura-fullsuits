<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Needed to talk to the embedded server over the loopback socket. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Phone-camera barcode scanning in Aura POS (optional; requested at runtime). -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!--
      Needed to HEAR the shop hub's addressing beacon on the LAN.

      Android's wifi stack filters out packets that are not explicitly
      addressed to this device, broadcast included, so a plain
      DatagramSocket bound to the beacon port receives NOTHING no matter how
      correctly it is written. Measured, not assumed: with the hub confirmed
      broadcasting every 5s (a desktop listener on the same wifi heard it
      immediately), the phone's own listener reported "No hub beacon heard
      on this sweep" on every single tick.

      A normal (non-dangerous) permission, granted at install and never
      prompted for, and it does nothing on its own: it only makes
      WifiManager.createMulticastLock() usable, which HubTransport acquires
      solely for the few seconds of each beacon listen and always releases
      (see its own comment on the battery cost).
    -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <application
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Aura">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout|uiMode"
            android:label="@string/app_name"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
