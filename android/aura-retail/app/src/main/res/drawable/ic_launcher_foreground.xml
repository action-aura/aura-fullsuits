<?xml version="1.0" encoding="utf-8"?>
<!--
    Launcher adaptive-icon foreground: the Aura mark (DESIGN.md §3), fixed
    to the SVG's own dark-surface ink (#EDF2F8) rather than a theme token: the
    launcher's ground (ic_launcher_background.xml) is always dark, the same
    way products/retail/frontend/brand/aura-app-icon.svg is drawn once for a
    dark ground rather than switching with the phone's theme. Compare
    ui/brand/AuraMark.kt, which draws the same 256-unit geometry in Compose
    with a theme-following `ink` for in-app use; this file is the launcher's
    own copy because adaptive icons cannot host a Composable.

    The whole mark is scaled 0.30x and offset (15.6, 15.6) so the ring (188
    units, 56.4dp) sits inside the adaptive icon's 66dp safe zone.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:scaleX="0.30"
        android:scaleY="0.30"
        android:translateX="15.6"
        android:translateY="15.6">

        <!-- Ring: 300 degree sweep, gap open top-right where the spark sits. -->
        <path
            android:pathData="M 159.4 39.4 A 94 94 0 1 1 66.95 56.5"
            android:strokeWidth="15"
            android:strokeLineCap="round">
            <aapt:attr name="android:strokeColor">
                <gradient
                    android:type="linear"
                    android:startX="38.4"
                    android:startY="230.4"
                    android:endX="217.6"
                    android:endY="25.6">
                    <item android:offset="0" android:color="#FF3F7BE6" />
                    <item android:offset="0.55" android:color="#FF6EA8FF" />
                    <item android:offset="1" android:color="#FF5FE3D0" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- Spark glow. -->
        <path android:pathData="M 176 60 a 20 20 0 1 0 40 0 a 20 20 0 1 0 -40 0">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="radial"
                    android:centerX="196"
                    android:centerY="60"
                    android:gradientRadius="20">
                    <item android:offset="0" android:color="#FFFFFFFF" />
                    <item android:offset="0.45" android:color="#FFBFF7EE" />
                    <item android:offset="1" android:color="#005FE3D0" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- Spark core. -->
        <path
            android:pathData="M 189.5 60 a 6.5 6.5 0 1 0 13 0 a 6.5 6.5 0 1 0 -13 0"
            android:fillColor="#FFFFFFFF" />

        <!-- The A: fixed light ink (#EDF2F8), the launcher ground is always dark. -->
        <path
            android:pathData="M 80 178 L 128 76 L 176 178"
            android:strokeColor="#FFEDF2F8"
            android:strokeWidth="19"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
        <path
            android:pathData="M 106 142 L 150 142"
            android:strokeColor="#FFEDF2F8"
            android:strokeWidth="15"
            android:strokeLineCap="round" />
    </group>
</vector>
