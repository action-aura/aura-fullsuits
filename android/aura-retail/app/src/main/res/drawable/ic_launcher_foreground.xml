<?xml version="1.0" encoding="utf-8"?>
<!--
    Launcher adaptive-icon foreground: the Aura pierced-A mark (Action-Aura-
    Brand-Guide.md). Geometry and colour are inlined verbatim from
    products/retail/frontend/brand/aura-mark-on-dark.svg, the DARK-GROUND
    variant, not the light-ground aura-mark.svg ui/brand/AuraMark.kt draws
    for in-app use. The launcher's ground (ic_launcher_background.xml) is a
    fixed dark navy gradient (#0E1A33 to #070B12, unchanged by this pass; it
    already matched this same dark ground before, and still does), so this
    mirrors aura-app-icon.svg's approach (which inlines this SAME dark-ground
    trio onto its own navy ground) rather than AuraMark.kt's fixed-but-
    different Retail-light trio, which assumes a light/neutral in-app
    surface, not a permanently dark disc.

    SCALE, derived from the brand guide's 25% clear-space rule, not
    invented: Android's adaptive-icon safe zone is a 66dp square centred in
    the 108dp viewport (developer.android.com/develop/ui/views/launch/
    icon_design_adaptive). "25% clear space on all sides" means each side's
    margin is 25% of the mark's own size, so mark plus both margins
    (mark * 1.5) must equal the 66dp safe zone: mark = 66 / 1.5 = 44dp,
    margin = 11dp/side inside the safe zone, on top of the system's own 21dp
    safe-zone-to-viewport margin, which is a platform requirement, not part
    of the brand's clear-space rule. 44 / 120 (the mark's own SVG design-box
    width) = 0.36667 scale; translate = (108 - 44) / 2 = 32, centring the
    44dp mark in the 108dp viewport.

    64px-minimum rule (Action-Aura-Brand-Guide.md "Usage"; see brand/
    README.md): the 3D/gradient construction is not for use below 64px,
    flat geometry (aura-mark-1bit.svg) is. NOT switched to flat here: the
    version of this file being replaced already used the 3D/gradient
    construction, and an adaptive icon is a single 108dp vector asset the OS
    rasterises at whatever final size the launcher/density/icon-pack choose,
    commonly well past 64px once device density is applied (e.g. a 48dp
    grid cell is already 192px at xxxhdpi), and this is not the small fixed
    raster the guide's sub-64px case is really describing: a receipt stamp,
    an embroidery, a favicon tab. Kept the 3D/gradient construction.

    2026-09-19: REDRAWN for the pierced-A redesign, replacing the old
    single-arc ring (one continuous 300-degree sweep of radius 94, drawn in
    a single stroke) plus upward-A plus beacon-diamond geometry. Compare
    ui/brand/AuraMark.kt, which draws the SAME pierced-A geometry in Compose
    (fixed AuraBrand Retail-light colours) for in-app use; this file is the
    launcher's own copy because adaptive icons cannot host a Composable.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:scaleX="0.36667"
        android:scaleY="0.36667"
        android:translateX="32"
        android:translateY="32">

        <!-- Back arc: passes BEHIND the letter's shoulders, dimmed. Same
             ellipse (rx=36, ry=8, centre 60,69) and -12deg rotation as the
             front arc below: the SAME ellipse pierced by one ring, not two
             independent arcs. -->
        <path
            android:pathData="M 24 69 A 36 8 0 0 1 96 69"
            android:strokeWidth="5"
            android:strokeAlpha="0.6">
            <aapt:attr name="android:strokeColor">
                <gradient
                    android:type="linear"
                    android:startX="24"
                    android:startY="69"
                    android:endX="96"
                    android:endY="69">
                    <item android:offset="0" android:color="#FF223B5E" />
                    <item android:offset="1" android:color="#FFDB9A57" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- Left facet (light-left): filled, sharing the apex (60,12.6)
             and shoulder (60,56) with the right facet below. The letter is
             two FILLED planes, not a stroked stem+bar. -->
        <path android:pathData="M60 12.6 L60 56 L40 104 L22 104 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="linear"
                    android:startX="60"
                    android:startY="12.6"
                    android:endX="60"
                    android:endY="104">
                    <item android:offset="0" android:color="#FFF6CFA0" />
                    <item android:offset="1" android:color="#FFDB9A57" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- Right facet (shadow-right): fades to the shared brand navy,
             the constant that reads every product's mark as a sibling. -->
        <path android:pathData="M60 12.6 L98 104 L80 104 L60 56 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="linear"
                    android:startX="60"
                    android:startY="12.6"
                    android:endX="60"
                    android:endY="104">
                    <item android:offset="0" android:color="#FFB87A45" />
                    <item android:offset="1" android:color="#FF1E3A5A" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- Ridge highlight: the lit seam between the two facets. -->
        <path
            android:pathData="M60 12.6 L60 56"
            android:strokeColor="#FFFDF0E0"
            android:strokeWidth="1.3"
            android:strokeAlpha="0.95" />

        <!-- Retail's own counter glyph: a small rounded square, "the
             module on the shelf", sitting in the A's triangular window
             where the ring shows through. -->
        <path
            android:pathData="M57.5 81.5 L62.5 81.5 A2 2 0 0 1 64.5 83.5 L64.5 88.5 A2 2 0 0 1 62.5 90.5 L57.5 90.5 A2 2 0 0 1 55.5 88.5 L55.5 83.5 A2 2 0 0 1 57.5 81.5 Z"
            android:fillColor="#FFDB9A57" />

        <!-- Front arc: sweeps ACROSS THE FRONT of the legs, full strength.
             Drawn after the facets/counter so it sits in front of them,
             exactly as aura-mark-on-dark.svg orders its elements. -->
        <path
            android:pathData="M 24 69 A 36 8 0 0 0 96 69"
            android:strokeWidth="6"
            android:strokeLineCap="round">
            <aapt:attr name="android:strokeColor">
                <gradient
                    android:type="linear"
                    android:startX="24"
                    android:startY="69"
                    android:endX="96"
                    android:endY="69">
                    <item android:offset="0" android:color="#FFDB9A57" />
                    <item android:offset="1" android:color="#FFF6CFA0" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- Energy node where the front arc ends: a soft halo behind a
             bright core, replacing the old beacon diamond entirely (no
             diamond, no radial-gradient glow). -->
        <path
            android:pathData="M95.2,61.5 m-7.5,0 a7.5,7.5 0 1,0 15,0 a7.5,7.5 0 1,0 -15,0"
            android:fillColor="#FFF6CFA0"
            android:fillAlpha="0.3" />
        <path
            android:pathData="M95.2,61.5 m-4,0 a4,4 0 1,0 8,0 a4,4 0 1,0 -8,0"
            android:fillColor="#FFFDF6EC" />
    </group>
</vector>
