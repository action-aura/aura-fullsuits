<?xml version="1.0" encoding="utf-8"?>
<!--
    Launcher adaptive-icon background: Night ground (DESIGN.md §3, "Night
    ground #070B12, the intro's and app icon's ground"), lit toward the
    ring's own blue so the mark reads as switched-on rather than pasted onto
    a flat disc. Replaces the flat #1A1A1A disc (values/colors.xml's
    ic_launcher_background) with the same two-stop diagonal the desktop's
    aura-app-icon.svg uses.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108"
                android:startColor="#FF0E1A33"
                android:endColor="#FF070B12" />
        </aapt:attr>
    </path>
</vector>
