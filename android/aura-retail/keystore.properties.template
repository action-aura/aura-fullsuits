# SIGNING CONFIG TEMPLATE — contains NO secrets.
# COPY this to `keystore.properties` (git-ignored) and fill in real values.
#
# Generate a keystore ONCE and reuse it for EVERY release update, so testers'
# on-device data survives updates (Android only preserves data across updates that
# are signed with the same key). Keep the .jks file + these passwords backed up
# securely — if you lose them you cannot update the app, only ship a new one.
#
# Create the keystore (run once, in the android/ folder):
#   keytool -genkeypair -v -keystore aura-release.jks -alias aura \
#           -keyalg RSA -keysize 2048 -validity 10000
#
storeFile=aura-release.jks
storePassword=CHANGE_ME
keyAlias=aura
keyPassword=CHANGE_ME
