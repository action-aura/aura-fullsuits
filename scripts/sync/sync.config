# aura-sync team defaults. Committed -- applies to every clone unless overridden.
#
# Per-dev overrides go in .autosync/sync.config.local (gitignored, never committed).
# Precedence: CLI flag > AURA_SYNC_* env var > .autosync/sync.config.local > this file.

# --- Scheduling ---
INTERVAL_SECONDS=300
JITTER_SECONDS=20

# --- Scope ---
SYNC_BRANCHES=master

# --- Integration strategy: rebase | merge | ff-only ---
PULL_STRATEGY=rebase

# --- Auto-commit / auto-push ---
AUTO_COMMIT=true
AUTO_PUSH=true
COMMIT_QUIET_SECONDS=90
COMMIT_PREFIX=chore(autosync)
AMEND_AUTOSYNC_COMMITS=true
AMEND_WINDOW_SECONDS=900

# --- Safety guards ---
MAX_FILE_KB=5120
PATH_DENYLIST=*.env,.env.*,*.pem,*.key,*.jks,*.keystore,*.pfx,*.p12,*.db,*.sqlite,*.sqlite3,*.apk,*.aab,*.dump,*.zip,*.exe,*.msi
SECRET_SCAN=true
CHURN_LIMIT=5
PRE_PUSH_CHECK=

# --- Push ---
PUSH_RETRIES=2

# --- Notifications ---
NOTIFY=true

# --- Logging ---
LOG_LEVEL=INFO
LOG_RETENTION_DAYS=14

# --- Locking / snapshots / failure handling ---
LOCK_STALE_SECONDS=900
SNAPSHOT_KEEP=50
AUTH_BACKOFF_MINUTES=30
MAX_CONSECUTIVE_FAILURES=5
