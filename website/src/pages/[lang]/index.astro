---
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import LiveTill from '../../components/LiveTill.astro';
import Facts from '../../components/Facts.astro';
import OfflineSwitch from '../../components/OfflineSwitch.astro';
import WhatItDoes from '../../components/WhatItDoes.astro';
import SetupChecklist from '../../components/SetupChecklist.astro';
import ProductCards from '../../components/ProductCards.astro';
import Close from '../../components/Close.astro';
import '../../styles/live-till.css';
import { dict, LANGS, type Lang } from '../../i18n';
import { organizationLd } from '../../lib/jsonld';

export function getStaticPaths() { return LANGS.map((lang) => ({ params: { lang } })); }
const lang = Astro.params.lang as Lang;
const t = dict(lang);
---
<Base lang={lang} slug="" title={t.meta.home.title} description={t.meta.home.description} jsonld={[organizationLd(lang)]}>
  <Nav lang={lang} slug="" />
  <main id="main">
    <section id="hero" class="lt-hero">
      <div class="lt-wrap">
        <LiveTill lang={lang} />
        <Facts lang={lang} />
      </div>
    </section>
    <OfflineSwitch lang={lang} />
    <WhatItDoes lang={lang} />
    <SetupChecklist lang={lang} />
    <ProductCards lang={lang} />
    <Close lang={lang} />
  </main>
  <Footer lang={lang} slug="" />
</Base>
