---
import Base from '../layouts/Base.astro';
import { dict } from '../i18n';

const en = dict('en');
const ar = dict('ar');
---
<Base lang="en" slug="404" title={en.meta.notFound.title} description={en.meta.notFound.description} world="master" noindex>
  <main id="main" class="wrap section">
    <div class="copy">
      <h1>
        <span lang="en">{en.notFound.title}</span>
        <span lang="ar" class="ar-title">{ar.notFound.title}</span>
      </h1>
      <p class="lead">
        <a href="/en/" lang="en" hreflang="en">{en.notFound.back}</a>
        {' '}
        <a href="/ar/" lang="ar" hreflang="ar">{ar.notFound.back}</a>
      </p>
    </div>
  </main>
</Base>
