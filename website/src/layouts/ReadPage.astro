---
import Base from './Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Jewel from '../components/Jewel.astro';
import type { Lang } from '../i18n';

interface Props {
  lang: Lang; slug: string; title: string; description: string;
  heading: string; draftNote?: string; jsonld?: object[];
}
const { lang, slug, title, description, heading, draftNote, jsonld = [] } = Astro.props;
---
<Base lang={lang} slug={slug} title={title} description={description} world="master" jsonld={jsonld}>
  <Nav lang={lang} slug={slug} />
  <Jewel lang={lang} stations="read" />
  <main id="main">
    <article class="read" data-w="master">
      <h1>{heading}</h1>
      {draftNote && <p class="draft-note" role="note">{draftNote}</p>}
      <slot />
    </article>
  </main>
  <Footer lang={lang} slug={slug} />
</Base>
