---
import { dict, type Lang } from '../i18n';
interface Props { lang: Lang; fixed?: { x: number; y: number; scale: number }; stations?: 'home' | 'product' | 'about' | 'contact' | 'read' }
const { lang, fixed, stations = 'home' } = Astro.props;
const t = dict(lang);
---
<div class="world-bg bg-master" aria-hidden="true"></div>
<div class="world-bg bg-retail" aria-hidden="true"></div>
<div class="world-bg bg-clinic" aria-hidden="true"></div>
<div class="world-bg bg-gym" aria-hidden="true"></div>
<div class="jewel" aria-hidden="true" data-kind={stations} data-read={stations === 'read' ? '1' : undefined} data-fixed={fixed ? JSON.stringify(fixed) : undefined}>
  {/* Stills are 1404x1296: the hero rest pose in a 13:12 frame 72/58 of the mark's height (tools/render-stills.mjs). The
      attributes give the aspect before load; components.css sets height and width: auto, so the attribute width is never used. */}
  {['master', 'retail', 'clinic', 'gym'].map((w) => (
    <img class={`jewel-still still-${w}`} src={`/jewel/still-${w}.webp`} alt="" width="1404" height="1296" decoding="async" />
  ))}
  <canvas class="jewel-canvas"></canvas>
</div>
<div class="world-scrim sc-master" aria-hidden="true"></div>
<div class="world-scrim sc-retail" aria-hidden="true"></div>
<div class="world-scrim sc-clinic" aria-hidden="true"></div>
<div class="world-scrim sc-gym" aria-hidden="true"></div>
<span class="visually-hidden">{t.a11y.jewel}</span>
<script>
  import { pickTier } from '../scripts/jewel/tier';
  import { stationsFor, stationAt, fitScale, footerFade, mirror, phoneHeroPose, phoneHeroFade, type PageKind, type Station } from '../scripts/jewel/stations';

  const root = document.documentElement;
  const layer = document.querySelector<HTMLElement>('.jewel')!;
  layer.querySelectorAll<HTMLImageElement>('.jewel-still').forEach((img) => {
    const hide = () => { img.hidden = true; };
    if (img.complete && img.naturalWidth === 0) hide();
    else img.addEventListener('error', hide, { once: true });
  });
  const canvas = layer.querySelector<HTMLCanvasElement>('.jewel-canvas')!;
  const rtl = root.dir === 'rtl';
  const phone = matchMedia('(max-width: 899px)').matches;
  const kind = (layer.dataset.kind ?? 'home') as PageKind;
  const found = stationsFor(kind, phone);
  const isRead = found === 'none';
  const stations: Station[] = isRead ? [] : found;
  if (isRead) layer.dataset.read = '1';
  const fixed = layer.dataset.fixed ? (JSON.parse(layer.dataset.fixed) as { x: number; y: number; scale: number }) : null;
  // Read pages: master still only, pinned top-right at 28% of viewport height (0.48 / 58%).
  const READ_STILL = { x: 0.86, y: 0.2, scale: 0.48 };
  const pinned = isRead ? READ_STILL : fixed;
  const nav = navigator as Navigator & { deviceMemory?: number; connection?: { saveData?: boolean } };
  const tier = pickTier({
    reducedMotion: matchMedia('(prefers-reduced-motion: reduce)').matches, webgl2: () => !!document.createElement('canvas').getContext('webgl2'),
    deviceMemory: nav.deviceMemory, saveData: nav.connection?.saveData, width: innerWidth, dpr: devicePixelRatio,
  });
  layer.dataset.tier = tier;

  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  type Mix = { master: number; retail: number; clinic: number; gym: number };
  type Scene = { setMix(m: Mix): void; setStation(s: { x: number; y: number; scale: number }): void; setProgress(p: number): void };
  const dominantOf = (m: Mix) => (Object.keys(m) as (keyof Mix)[]).reduce((a, b) => (m[b] > m[a] ? b : a), 'master' as keyof Mix);
  const markMix = (m: Mix) => { layer.dataset.mix = dominantOf(m); };
  const currentMix = (): Mix => (root as any).__auraMix ?? { master: 1, retail: 0, clinic: 0, gym: 0 };
  markMix(currentMix());
  root.addEventListener('worldmix', (e) => markMix((e as CustomEvent).detail));

  // Phones, home and product pages: the mark lives in the hero only, placed under the hero copy so the whole mark shows,
  // then faded out as the hero scrolls away. Chapters get nothing behind their text (E1).
  const heroPhone = phone && !pinned && (kind === 'home' || kind === 'product');
  const heroEl = heroPhone ? document.querySelector<HTMLElement>('main [data-w]') : null;
  const heroCopy = heroEl?.querySelector<HTMLElement>('.copy') ?? null;
  let copyBottom = 0;
  const measureHero = () => { if (heroCopy) copyBottom = heroCopy.getBoundingClientRect().bottom + scrollY; };

  const apply = (s0: Station) => {
    let s = s0, heroFade = 0;
    if (heroEl && heroCopy) {
      const pose = phoneHeroPose(copyBottom, innerWidth, innerHeight);
      s = { ...s0, y: pose.y, scale: pose.scale };
      heroFade = phoneHeroFade(heroEl.getBoundingClientRect().bottom, innerHeight);
    }
    // Phones: the big mark would swamp the copy on the 404 page, so cap its scale.
    const sc = fixed && innerWidth < 900 ? Math.min(s.scale, 1) : s.scale;
    // Desktop: fit the mark to the viewport. Hide check below still reads the station's own scale.
    const fitted = phone ? sc : fitScale(s.scale, innerWidth, innerHeight);
    // --jhide is how far the mark is hidden, 0..1: fully for a scale-0 station (product pages after the hero on
    // phones), 1 - alpha for a dissolved station (desktop day rail and features grid), 0 otherwise,
    // and it fades out as the footer rises (footerFade).
    const foot = document.querySelector('footer');
    const fade = foot ? footerFade(foot.getBoundingClientRect().top, innerHeight) : 0;
    const hide = sc <= 0.01 ? 1 : Math.max(1 - (s.alpha ?? 1), fade, heroFade);
    root.style.setProperty('--jx', String(s.x));
    // Hero pose on phones: s.y is the apex, so the glow (--jy) centres half a mark lower, on the mark itself.
    root.style.setProperty('--jy', String(heroEl ? s.y + (0.567 * innerWidth * sc) / innerHeight : s.y));
    root.style.setProperty('--js', String(fitted));
    // Phone still apex, as a viewport fraction. Only the hero pose moves it; every other phone page keeps the apex at
    // mid-height as before (the stations' own phone y was never used).
    root.style.setProperty('--jay', heroEl ? String(Math.round(s.y * 10000) / 10000) : '0.5');
    root.style.setProperty('--jhide', String(Math.round(hide * 1000) / 1000));
    return { x: s.x, y: s.y, scale: fitted };
  };
  const centres = () => Array.from(document.querySelectorAll<HTMLElement>('[data-w]')).map(
    (el) => el.getBoundingClientRect().top + scrollY + el.offsetHeight / 2);
  let cs = pinned ? [] : centres();
  measureHero();
  let scene: Scene | null = null;
  const progress = () => {
    const p = scrollY / Math.max(1, document.documentElement.scrollHeight - innerHeight);
    scene?.setProgress(Math.min(1, Math.max(0, p)));
  };
  const place = () => {
    let s;
    // Pinned stations (read pages, 404) go through no stationAt, so mirror them here: on Arabic read pages the
    // still sat top-right behind the right-aligned headings (invisible until Plan 3 shipped the still files).
    if (pinned) s = rtl ? mirror(pinned) : pinned;
    else {
      const c = scrollY + innerHeight / 2;
      let at = c;
      if (reduced && cs.length) {
        // Reduced motion: snap to the nearest station, no interpolation.
        at = cs.reduce((a, b) => (Math.abs(b - c) < Math.abs(a - c) ? b : a));
      }
      s = stationAt(stations, cs, at, rtl, innerHeight);
    }
    const out = apply(s);
    scene?.setStation(out);
    progress();
    return out;
  };
  const remeasure = () => { if (!pinned) cs = centres(); measureHero(); place(); };
  if (!pinned) {
    addEventListener('scroll', place, { passive: true });
    addEventListener('load', remeasure);
    document.fonts?.ready.then(remeasure);
    const main = document.querySelector('main');
    if (main && typeof ResizeObserver !== 'undefined') new ResizeObserver(remeasure).observe(main);
  }
  addEventListener('resize', remeasure);
  place();

  if (tier === 'rich' && !isRead) {
    addEventListener('load', async () => {
      try {
        const { mountJewel } = await import('../scripts/jewel/scene.js');
        const j = mountJewel(canvas, { phone });
        canvas.addEventListener('webglcontextlost', () => layer.classList.remove('is-live'));
        const push = (m: Mix) => { j.setMix(m); layer.dataset.sceneMix = dominantOf(m); };
        push(currentMix());
        root.addEventListener('worldmix', (e) => push((e as CustomEvent).detail));
        scene = j;
        place();
        layer.classList.add('is-live');
      } catch {
        // Import or WebGL failed: stills stay visible, scroll placement keeps working.
      }
    }, { once: true });
  }
</script>
