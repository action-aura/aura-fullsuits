---
import { dict, type Lang } from '../i18n';
interface Props { lang: Lang; fixed?: { x: number; y: number; scale: number } }
const { lang, fixed } = Astro.props;
const t = dict(lang);
---
<div class="world-bg bg-master" aria-hidden="true"></div>
<div class="world-bg bg-retail" aria-hidden="true"></div>
<div class="world-bg bg-clinic" aria-hidden="true"></div>
<div class="world-bg bg-gym" aria-hidden="true"></div>
<div class="jewel" aria-hidden="true" data-fixed={fixed ? JSON.stringify(fixed) : undefined}>
  {['master', 'retail', 'clinic', 'gym'].map((w) => (
    <img class={`jewel-still still-${w}`} src={`/jewel/still-${w}.webp`} alt="" width="900" height="1200" decoding="async" />
  ))}
  <canvas class="jewel-canvas"></canvas>
</div>
<div class="world-scrim sc-master" aria-hidden="true"></div>
<div class="world-scrim sc-retail" aria-hidden="true"></div>
<div class="world-scrim sc-clinic" aria-hidden="true"></div>
<div class="world-scrim sc-gym" aria-hidden="true"></div>
<span class="visually-hidden">{t.a11y.jewel}</span>
<script>
  import { pickTier } from '../scripts/jewel/tier';
  import { HOME_DESKTOP, HOME_PHONE, stationAt } from '../scripts/jewel/stations';

  const root = document.documentElement;
  const layer = document.querySelector<HTMLElement>('.jewel')!;
  layer.querySelectorAll<HTMLImageElement>('.jewel-still').forEach((img) => {
    const hide = () => { img.hidden = true; };
    if (img.complete && img.naturalWidth === 0) hide();
    else img.addEventListener('error', hide, { once: true });
  });
  const canvas = layer.querySelector<HTMLCanvasElement>('.jewel-canvas')!;
  const rtl = root.dir === 'rtl';
  const phone = matchMedia('(max-width: 899px)').matches;
  const stations = phone ? HOME_PHONE : HOME_DESKTOP;
  const fixed = layer.dataset.fixed ? (JSON.parse(layer.dataset.fixed) as { x: number; y: number; scale: number }) : null;
  const gl2 = !!document.createElement('canvas').getContext('webgl2');
  const nav = navigator as Navigator & { deviceMemory?: number; connection?: { saveData?: boolean } };
  const tier = pickTier({
    reducedMotion: matchMedia('(prefers-reduced-motion: reduce)').matches, webgl2: gl2,
    deviceMemory: nav.deviceMemory, saveData: nav.connection?.saveData, width: innerWidth, dpr: devicePixelRatio,
  });
  layer.dataset.tier = tier;

  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  type Mix = { master: number; retail: number; clinic: number; gym: number };
  type Scene = { setMix(m: Mix): void; setStation(s: { x: number; y: number; scale: number }): void; setProgress(p: number): void };
  const dominantOf = (m: Mix) => (Object.keys(m) as (keyof Mix)[]).reduce((a, b) => (m[b] > m[a] ? b : a), 'master' as keyof Mix);
  const markMix = (m: Mix) => { layer.dataset.mix = dominantOf(m); };
  const currentMix = (): Mix => (root as any).__auraMix ?? { master: 1, retail: 0, clinic: 0, gym: 0 };
  markMix(currentMix());
  root.addEventListener('worldmix', (e) => markMix((e as CustomEvent).detail));

  const apply = (s: { x: number; y: number; scale: number }) => {
    // Phones: the big mark would swamp the copy on the 404 page, so cap its scale.
    const sc = fixed && innerWidth < 900 ? Math.min(s.scale, 1) : s.scale;
    root.style.setProperty('--jx', String(s.x));
    root.style.setProperty('--jy', String(s.y));
    root.style.setProperty('--js', String(sc));
    return { x: s.x, y: s.y, scale: sc };
  };
  const centres = () => Array.from(document.querySelectorAll<HTMLElement>('[data-w]')).map(
    (el) => el.getBoundingClientRect().top + scrollY + el.offsetHeight / 2);
  let cs = fixed ? [] : centres();
  let scene: Scene | null = null;
  const progress = () => {
    const p = scrollY / Math.max(1, document.documentElement.scrollHeight - innerHeight);
    scene?.setProgress(Math.min(1, Math.max(0, p)));
  };
  const place = () => {
    let s;
    if (fixed) s = fixed;
    else {
      const c = scrollY + innerHeight / 2;
      let at = c;
      if (reduced && cs.length) {
        // Reduced motion: snap to the nearest station, no interpolation.
        at = cs.reduce((a, b) => (Math.abs(b - c) < Math.abs(a - c) ? b : a));
      }
      s = stationAt(stations, cs, at, rtl);
    }
    const out = apply(s);
    scene?.setStation(out);
    progress();
    return out;
  };
  const remeasure = () => { if (!fixed) cs = centres(); place(); };
  if (!fixed) {
    addEventListener('scroll', place, { passive: true });
    addEventListener('load', remeasure);
    document.fonts?.ready.then(remeasure);
    const main = document.querySelector('main');
    if (main && typeof ResizeObserver !== 'undefined') new ResizeObserver(remeasure).observe(main);
  }
  addEventListener('resize', remeasure);
  place();

  if (tier === 'rich') {
    addEventListener('load', async () => {
      try {
        const { mountJewel } = await import('../scripts/jewel/scene.js');
        const j = mountJewel(canvas, { phone });
        canvas.addEventListener('webglcontextlost', () => layer.classList.remove('is-live'));
        const push = (m: Mix) => { j.setMix(m); layer.dataset.sceneMix = dominantOf(m); };
        push(currentMix());
        root.addEventListener('worldmix', (e) => push((e as CustomEvent).detail));
        scene = j;
        place();
        layer.classList.add('is-live');
      } catch {
        // Import or WebGL failed: stills stay visible, scroll placement keeps working.
      }
    }, { once: true });
  }
</script>
