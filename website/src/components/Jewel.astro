---
// The 3D jewel, now only on About and only inside the navy band at the top of that page (Look 1: the rest of the site
// is light). It is a sibling placed right after the nav and before <main>: the band section in <main> is transparent
// and shows it through, and everything after the band is on the ivory page. Desktop only (phones get a plain navy
// band with the text), and the station is pinned, so there is no scroll choreography any more.
import { dict, type Lang } from '../i18n';
interface Props { lang: Lang; station?: { x: number; y: number; scale: number } }
const { lang, station = { x: 0.72, y: 0.5, scale: 1.1 } } = Astro.props;
const t = dict(lang);
---
<div class="jewel-anchor" aria-hidden="true">
  <div class="jewel-band">
    <div class="jewel" data-station={JSON.stringify(station)}>
      {/* The still is 1404x1296: the hero rest pose in a 13:12 frame 72/58 of the mark's height (tools/render-stills.mjs).
          The attributes give the aspect before load; components.css sets height and width: auto, so the attribute width is never used. */}
      <img class="jewel-still still-master" src="/jewel/still-master.webp" alt="" width="1404" height="1296" decoding="async" />
      <canvas class="jewel-canvas"></canvas>
    </div>
  </div>
</div>
<span class="visually-hidden">{t.a11y.jewel}</span>
<script>
  import { pickTier } from '../scripts/jewel/tier';
  import { fitScale, mirror } from '../scripts/jewel/stations';

  const root = document.documentElement;
  const layer = document.querySelector<HTMLElement>('.jewel')!;
  const img = layer.querySelector<HTMLImageElement>('.jewel-still')!;
  const hide = () => { img.hidden = true; };
  if (img.complete && img.naturalWidth === 0) hide();
  else img.addEventListener('error', hide, { once: true });
  const canvas = layer.querySelector<HTMLCanvasElement>('.jewel-canvas')!;
  const rtl = root.dir === 'rtl';
  const phone = matchMedia('(max-width: 899px)').matches;
  const raw = JSON.parse(layer.dataset.station!) as { x: number; y: number; scale: number };
  // x is mirrored here for RTL (the CSS uses `left`, the one physical-property exception, so it must not mirror again).
  const station = rtl ? mirror(raw) : raw;
  const nav = navigator as Navigator & { deviceMemory?: number; connection?: { saveData?: boolean } };
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const tier = pickTier({
    reducedMotion: reduced, webgl2: () => !!document.createElement('canvas').getContext('webgl2'),
    deviceMemory: nav.deviceMemory, saveData: nav.connection?.saveData, width: innerWidth, dpr: devicePixelRatio,
  });
  layer.dataset.tier = tier;

  type Scene = { setMix(m: Record<string, number>): void; setStation(s: { x: number; y: number; scale: number }): void; setProgress(p: number): void };
  let scene: Scene | null = null;
  // The band is not the viewport: fit the mark to the band's own box, like the old viewport fit.
  const place = () => {
    const fitted = phone ? station.scale : fitScale(station.scale, layer.clientWidth || innerWidth, layer.clientHeight || innerHeight);
    root.style.setProperty('--jx', String(station.x));
    root.style.setProperty('--jy', String(station.y));
    root.style.setProperty('--js', String(fitted));
    scene?.setStation({ x: station.x, y: station.y, scale: fitted });
  };
  addEventListener('resize', place);
  place();

  if (tier === 'rich' && !phone) {
    addEventListener('load', async () => {
      try {
        const { mountJewel } = await import('../scripts/jewel/scene.js');
        const j = mountJewel(canvas, { phone });
        canvas.addEventListener('webglcontextlost', () => layer.classList.remove('is-live'));
        j.setMix({ master: 1, retail: 0, clinic: 0, gym: 0 });
        j.setProgress(0);
        scene = j;
        place();
        layer.classList.add('is-live');
      } catch {
        // Import or WebGL failed: the still stays visible.
      }
    }, { once: true });
  }
</script>
