---
// Same widget and site key as the demo form. Without a site key (local dev) nothing renders and the Function's
// ALLOW_NO_TURNSTILE switch decides, exactly as for /api/demo.
const sitekey = import.meta.env.PUBLIC_TURNSTILE_SITEKEY ?? '';
---
{sitekey && <div class="cf-turnstile" data-sitekey={sitekey}></div>}
{sitekey && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}
