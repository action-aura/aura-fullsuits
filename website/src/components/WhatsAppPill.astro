---
import { dict, type Lang } from '../i18n';
import { waLink } from '../lib/lang';

interface Props {
  lang: Lang;
  text?: string;
  label?: string;
}

const { lang, text, label } = Astro.props;
const t = dict(lang);
---

<a class="wa-pill" href={waLink(text ?? t.cta.waText)} target="_blank" rel="noopener">
  <span class="wa-disc" aria-hidden="true">
    <svg viewBox="0 0 24 24" width="20" height="20" fill="#fff" focusable="false">
      <path d="M12 2.2a9.7 9.7 0 0 0-8.4 14.6L2.3 21.7l5-1.3A9.7 9.7 0 1 0 12 2.2Zm0 17.7c-1.5 0-3-.4-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8 8 0 1 1 12 19.9Zm4.4-6c-.2-.1-1.4-.7-1.7-.8-.2-.1-.4-.1-.5.1l-.8 1c-.1.2-.3.2-.5.1a6.6 6.6 0 0 1-3.3-2.9c-.2-.4.2-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.5-.4h-.5a.9.9 0 0 0-.7.3 2.8 2.8 0 0 0-.9 2.1 4.9 4.9 0 0 0 1 2.6 11.2 11.2 0 0 0 4.3 3.8c1.6.7 2.2.7 3 .6a2.5 2.5 0 0 0 1.7-1.2 2 2 0 0 0 .1-1.2c0-.1-.2-.2-.5-.3Z"></path>
    </svg>
  </span>
  <span class="wa-label">{label ?? t.cta.whatsapp}</span>
</a>
