---
import { dict, type Lang } from '../i18n';
import { pagePath } from '../lib/seo';
import { PHONE_TEL, waLink, INSTAGRAM } from '../lib/lang';
import StatusPill from './StatusPill.astro';
import FlatMark from './FlatMark.astro';

interface Props {
  lang: Lang;
  slug?: string;
}

const { lang, slug = '' } = Astro.props;
const t = dict(lang);
const f = t.footer;
const other: Lang = lang === 'en' ? 'ar' : 'en';
---
<footer class="footer">
  <div class="footer-grid">
    <div class="footer-brand">
      <a class="footer-name" href={pagePath(lang, '')}>
        <FlatMark class="footer-mark" size={28} />
        {t.nav.brand}
      </a>
      <p class="footer-tagline">{f.tagline}</p>
    </div>

    <nav class="footer-col" aria-label={f.products}>
      <h3 class="footer-title">{f.products}</h3>
      <ul class="footer-list">
        <li><a href={pagePath(lang, 'aura-retail')}>{t.nav.retail}</a></li>
        <li><a href={pagePath(lang, 'aura-clinic')}>{t.nav.clinic}</a></li>
        <li class="footer-soon"><span>{t.nav.gym}</span> <StatusPill kind="coming" lang={lang} /></li>
      </ul>
    </nav>

    <nav class="footer-col" aria-label={f.company}>
      <h3 class="footer-title">{f.company}</h3>
      <ul class="footer-list">
        <li><a href={pagePath(lang, 'about')}>{t.nav.about}</a></li>
        <li><a href={pagePath(lang, 'faq')}>{f.faq}</a></li>
        <li><a href={pagePath(lang, 'contact')}>{t.nav.demo}</a></li>
        <li><a href={pagePath(lang, 'privacy')}>{f.privacy}</a></li>
        <li><a href={pagePath(lang, 'terms')}>{f.terms}</a></li>
      </ul>
    </nav>
  </div>

  <div class="footer-bottom">
    <span class="footer-city">{t.nav.brand} · {f.city}</span>
    <a class="footer-phone num" href={PHONE_TEL}>{f.phone}</a>
    <a class="footer-wa" href={waLink(t.cta.waText)} target="_blank" rel="noopener">{t.cta.whatsapp}</a>
    <a class="footer-ig" href={INSTAGRAM} target="_blank" rel="noopener me">{f.instagram}</a>
    <a class="footer-lang" hreflang={other} lang={other} href={pagePath(other, slug)}>{t.nav.switchTo}</a>
  </div>
</footer>
