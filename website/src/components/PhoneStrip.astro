---
import { dict, type Lang } from '../i18n';
import { PHONE_TEL, waLink } from '../lib/lang';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = dict(lang);
// City only. The full street address lives on the Contact page and in jsonld.ts and nowhere else.
---
<div class="strip" role="group" aria-label={t.strip.label}>
  <div class="strip-inner">
    <span class="strip-city">{t.strip.city}</span>
    <span class="strip-end">
      <a class="strip-phone num" href={PHONE_TEL}>{t.footer.phone}</a>
      <a class="strip-wa" href={waLink(t.cta.waText)} target="_blank" rel="noopener">{t.strip.whatsapp}</a>
    </span>
  </div>
</div>
