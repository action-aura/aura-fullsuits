---
import { dict, type Lang } from '../i18n/index';
import { pagePath } from '../lib/seo';
import StatusPill from './StatusPill.astro';
import { PHONE_TEL, waLink } from '../lib/lang';
import { ACCOUNTS_ON, accountPath } from '../lib/accounts';

interface Props {
  lang: Lang;
  slug: string;
  // Pages whose slug has sub-pages (the account area) say where the other language's twin lives.
  switchPath?: string;
}

const { lang, slug, switchPath } = Astro.props;
const t = dict(lang);
const other: Lang = lang === 'en' ? 'ar' : 'en';
const cur = (s: string) => (s === slug ? 'page' : undefined);
const otherHref = switchPath ?? pagePath(other, slug);
---
{/* Phone strip: city, phone, WhatsApp. Phones only (CSS), master navy, scrolls away. Phone is a single LTR run inside RTL text. */}
<div class="phone-strip">
  <span class="phone-strip-city">{t.footer.city}</span>
  <a class="phone-strip-tel" href={PHONE_TEL}><bdi dir="ltr">{t.footer.phone}</bdi></a>
  <a class="phone-strip-wa" href={waLink('')} target="_blank" rel="noopener">{t.nav.stripWa}</a>
</div>
<header class="nav">
  <a class="nav-brand" href={pagePath(lang, '')}>
    <svg class="nav-mark" width="22" height="22" viewBox="0 0 120 120" aria-hidden="true" focusable="false">
      <path d="M60 12.6 L98 104 L80 104 L60 56 L40 104 L22 104 Z" fill="currentColor"/>
      <path d="M 24 69 A 36 8 0 0 0 96 69" transform="rotate(-12 60 69)" fill="none" stroke="currentColor" stroke-width="9" stroke-linecap="round"/>
    </svg>
    {t.nav.brand}
  </a>

  <nav class="nav-links" aria-label={t.a11y.nav}>
    <a class="nav-link" data-chapter-link="retail" href={pagePath(lang, 'aura-retail')} aria-current={cur('aura-retail')}>{t.nav.retail}</a>
    <a class="nav-link" data-chapter-link="clinic" href={pagePath(lang, 'aura-clinic')} aria-current={cur('aura-clinic')}>{t.nav.clinic}</a>
    <a class="nav-link" data-chapter-link="gym" href={pagePath(lang, '') + '#gym'}>{t.nav.gym}</a>
    <StatusPill kind="coming" lang={lang} />
    <a class="nav-link" href={pagePath(lang, 'about')} aria-current={cur('about')}>{t.nav.about}</a>
    {ACCOUNTS_ON && <a class="nav-link nav-account" href={accountPath(lang)} aria-current={cur('account')}>{t.nav.signIn}</a>}
    <a class="nav-lang" hreflang={other} lang={other} href={otherHref}>{t.nav.switchTo}</a>
    <a class="nav-demo" href={pagePath(lang, 'contact')} aria-current={cur('contact')}>{t.nav.demo}</a>
  </nav>

  <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="nav-sheet" data-menu={t.nav.menu} data-close={t.nav.close}>
    <span class="nav-toggle-bars" aria-hidden="true"></span>
    <span class="nav-toggle-label visually-hidden">{t.nav.menu}</span>
  </button>

  <div id="nav-sheet" class="nav-sheet" hidden>
    <a class="nav-sheet-link" data-chapter-link="retail" href={pagePath(lang, 'aura-retail')} aria-current={cur('aura-retail')}>{t.nav.retail}</a>
    <a class="nav-sheet-link" data-chapter-link="clinic" href={pagePath(lang, 'aura-clinic')} aria-current={cur('aura-clinic')}>{t.nav.clinic}</a>
    <a class="nav-sheet-link" data-chapter-link="gym" href={pagePath(lang, '') + '#gym'}>{t.nav.gym} <StatusPill kind="coming" lang={lang} /></a>
    <a class="nav-sheet-link" href={pagePath(lang, 'about')} aria-current={cur('about')}>{t.nav.about}</a>
    {ACCOUNTS_ON && <a class="nav-sheet-link nav-account" href={accountPath(lang)} aria-current={cur('account')}>{t.nav.signIn}</a>}
    <a class="nav-sheet-link nav-lang" hreflang={other} lang={other} href={otherHref}>{t.nav.switchTo}</a>
    <a class="nav-sheet-link nav-demo" href={pagePath(lang, 'contact')} aria-current={cur('contact')}>{t.nav.demo}</a>
  </div>
</header>
<script>import '../scripts/nav';</script>
