---
// Three facts under the hero till (directions.md 8.4). Steady on purpose: no motion.
import { dict, type Lang } from '../i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const facts = dict(lang).home.facts;
// Icon paths from the spec: wifi, phone, pin.
const ICONS = [
  '<path d="M2 9a15 15 0 0 1 20 0M5.5 12.5a10 10 0 0 1 13 0M9 16a5 5 0 0 1 6 0"/><circle cx="12" cy="19.5" r="1.2" fill="currentColor"/>',
  '<rect x="7" y="2.5" width="10" height="19" rx="2.5"/><path d="M11 18.5h2"/>',
  '<path d="M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.8 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.5"/>',
];
---
<ul class="lt-facts">
  {facts.map((f, i) => (
    <li class="lt-fact">
      <span class="lt-fc"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" set:html={ICONS[i]} /></span>
      <h2 class="lt-fh">{f.title}</h2>
      <p>{f.body}</p>
    </li>
  ))}
</ul>
