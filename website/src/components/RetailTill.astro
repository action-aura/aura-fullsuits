---
// Retail chapter, part 1: the live till. Server-rendered so the page reads complete without JS; src/scripts/live-till.ts
// makes it sell. Prices are EXAMPLE prices (the footnote says so). The script reads item names and prices back out of
// the DOM, so this markup is the single source of truth. Looks: retail world tokens, light "screens" for the two devices.
import { dict, type Lang } from '../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const k = dict(lang).home.till;
const BARS = [30, 44, 26, 52, 38, 58, 8];
---
<section class="demo demo-till" id="till" data-w="retail" aria-labelledby="till-h">
  <div class="demo-inner">
    <div class="demo-copy reveal">
      <p class="demo-eyebrow">{k.eyebrow}</p>
      <h2 id="till-h">{k.title}</h2>
      <p class="lead">{k.lead}</p>
    </div>
    <div class="demo-stage reveal-card">
      <div class="lt-till-wrap" data-till data-empty={k.empty} data-live-total={k.liveTotal} data-live-done={k.liveDone} role="group" aria-label={k.label}>
        <div class="lt-till">
          <div class="lt-th">
            <div class="lt-th-l">
              <svg viewBox="0 0 28 28" width="16" height="16" aria-hidden="true" focusable="false"><path d="M14 2 L3 26 H11 Z" fill="var(--accent)" /><path d="M14 2 L25 26 H17 Z" fill="currentColor" /></svg>
              {k.brand}<span>{k.cashier}</span>
            </div>
            <div class="lt-chip"><i aria-hidden="true"></i>{k.online}</div>
          </div>
          <div class="lt-tbody">
            <div class="lt-items">
              {k.items.map((it) => (
                <button type="button" class="lt-item" data-item data-name={it.name} data-price={it.price}>
                  <span class="lt-n">{it.name}</span>
                  <span class="num">{it.price}</span>
                </button>
              ))}
            </div>
            <div class="lt-bill">
              <div class="lt-bh"><b>{k.bill}</b><span class="num" data-billno>#1042</span></div>
              <ul class="lt-lines" data-lines><li class="lt-empty">{k.empty}</li></ul>
              <div class="lt-div"></div>
              <div class="lt-trow"><span class="lt-lb">{k.total}</span><span><span class="num lt-total" data-total>0.000</span><span class="lt-cur"> {k.currency}</span></span></div>
              <button type="button" class="lt-pay" data-pay disabled>{k.pay}</button>
              <div class="lt-done" data-done aria-hidden="true">{k.done} · <span class="num" data-donesum>0.000</span> {k.currency}</div>
            </div>
          </div>
        </div>
        <p class="lt-foot">{k.footnote}</p>
        <div class="lt-phone"><div class="lt-pscr" data-pscr>
          <div class="lt-pt">{k.phoneApp}</div>
          <div class="lt-pk">{k.today}</div>
          <div><span class="num lt-big" data-ptotal>0.000</span><span class="lt-pu"> {k.currency}</span></div>
          <div class="lt-pcnt">{k.count}<span class="num" data-pcount>0</span></div>
          <div class="lt-bars" data-bars>{BARS.map((px) => <i style={`height:${px}px`}></i>)}</div>
        </div></div>
        <p class="visually-hidden" aria-live="polite" data-live></p>
      </div>
    </div>
  </div>
</section>
<script>import '../scripts/live-till';</script>
