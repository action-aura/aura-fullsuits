---
import { dict } from '../i18n/index';

interface Props {
  kind: 'available' | 'coming';
}

const { kind } = Astro.props;
const en = dict('en').status[kind];
const ar = dict('ar').status[kind];
---
<span class={`status-pill status-${kind}`}><i class="status-dot" aria-hidden="true"></i><span lang="en">{en}</span><span lang="ar">{ar}</span></span>
