-- M4 -- real, faithful port of products/retail/backend/database/schema.py's
-- branches/categories/products tables. Money/quantity columns are TEXT
-- (canonical decimal strings, never SQLite REAL/binary float -- see
-- docs/retail/unified_mobile/shared-database-schema-decision.md).
-- created_at is epoch milliseconds (INTEGER), matching Milestone 3's
-- FinalizedSaleSnapshot.createdAtEpochMillis contract exactly.

CREATE TABLE branches (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    company_id INTEGER NOT NULL DEFAULT 1,
    name TEXT NOT NULL,
    address TEXT,
    phone TEXT,
    status TEXT NOT NULL DEFAULT 'active',
    created_at INTEGER NOT NULL
);
CREATE INDEX branches_company_id ON branches(company_id);

CREATE TABLE categories (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    company_id INTEGER NOT NULL DEFAULT 1,
    name TEXT NOT NULL,
    description TEXT,
    -- CANONICAL_UNIFIED (M1 override, complete-retail-capability-matrix.md):
    -- the real Python schema has no status/archive column at all for
    -- categories -- added here as new, real capability, not a port of an
    -- existing column.
    status TEXT NOT NULL DEFAULT 'active',
    created_at INTEGER NOT NULL
);
CREATE INDEX categories_company_id ON categories(company_id);
-- CANONICAL_UNIFIED: real duplicate-name protection the Python authority
-- never had (complete-retail-capability-matrix.md's Categories finding).
-- Partial (status = 'active' only) -- real bug found by M5.3's own test
-- (reactivateRejectedIfADuplicateWasCreatedWhileArchived): a plain,
-- unconditional UNIQUE index blocks reusing a name after its original
-- category is archived, which is the exact, intended M5.3 UX (archive
-- "Beverages", create a new "Beverages" later). This is a defense-in-depth
-- backstop for the exact-string case only -- the real dedup logic
-- (Arabic/Unicode NFKC-normalized, active-rows-only) lives in
-- CreateCategoryUseCase/ReactivateCategoryUseCase (category-domain-
-- contract.md), not here. Same partial-unique-index pattern already used
-- by returns_idempotency (Returns.sq).
CREATE UNIQUE INDEX categories_company_name ON categories(company_id, name) WHERE status = 'active';

-- M5.5 -- sku/barcode are COLLATE NOCASE: a real audit finding
-- (product-inventory-authority-audit.md #4) is that the legacy backend's
-- SKU uniqueness check is case-sensitive while the legacy Android app's
-- own client-side barcode/SKU scan matching is case-insensitive -- an
-- existing internal inconsistency in the shipped legacy product, not a
-- deliberate design. CANONICAL_UNIFIED: resolved by making storage-level
-- comparison (uniqueness AND lookup) case-insensitive uniformly for both
-- columns (barcode-and-sku-contract.md) -- the stored byte value itself is
-- never case-folded, only comparison/uniqueness is. normalized_name and
-- updated_at are NEW_COMPLETE_PRODUCT_REQUIREMENT additions (audit's own
-- classification) -- neither exists in the legacy schema.
CREATE TABLE products (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    company_id INTEGER NOT NULL DEFAULT 1,
    sku TEXT NOT NULL COLLATE NOCASE,
    barcode TEXT COLLATE NOCASE,
    name TEXT NOT NULL,
    normalized_name TEXT NOT NULL,
    category_id INTEGER REFERENCES categories(id),
    cost_price TEXT NOT NULL DEFAULT '0.00',
    sell_price TEXT NOT NULL DEFAULT '0.00',
    tax_rate TEXT NOT NULL DEFAULT '0',
    unit TEXT NOT NULL DEFAULT 'pcs',
    reorder_level INTEGER NOT NULL DEFAULT 5,
    status TEXT NOT NULL DEFAULT 'active',
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL
);
CREATE INDEX products_company_id ON products(company_id);
CREATE INDEX products_category_id ON products(category_id);
-- Unconditional (all statuses), matching the real legacy authority exactly
-- (retail_api.py:253-257 checks for an existing sku regardless of status) --
-- unlike categories_company_name, this is LEGACY_PARITY, not
-- CANONICAL_UNIFIED: the legacy system already permanently reserves a SKU
-- company-wide once used, even after the product is soft-deleted. Proven
-- by skuCannotBeReusedAfterArchiving (product-domain-contract.md).
CREATE UNIQUE INDEX products_company_sku ON products(company_id, sku);
-- Partial + unconditional-across-statuses: NULL and '' are both exempt
-- (never conflict with each other or anything else -- "do not make
-- multiple null values conflict"), but an archived product's barcode is
-- NOT exempt -- "do not allow an archived Product barcode to be silently
-- reused" is an explicit M5.5.2 requirement, unlike Category's own
-- active-only reuse policy.
CREATE UNIQUE INDEX products_company_barcode ON products(company_id, barcode) WHERE barcode IS NOT NULL AND barcode != '';
-- M5.5.16 -- real finding, found by actually running EXPLAIN QUERY PLAN at
-- 10K-product scale, not assumed: SQLite's query planner does not use a
-- PARTIAL index (products_company_barcode above) unless it can prove the
-- query's WHERE clause satisfies the index's own partial condition --
-- confirmed by diagnostic testing that even the maximally-specific query
-- `WHERE barcode = ? AND company_id = ?` fell back to a much less
-- selective index (or a full scan) rather than ever choosing the partial
-- index. A plain, unconditional companion index has no such proof
-- requirement and was confirmed, by the same real testing, to be chosen
-- correctly. This index exists PURELY for real lookup performance;
-- products_company_barcode remains the actual uniqueness authority.
CREATE INDEX products_barcode_lookup ON products(company_id, barcode);
CREATE INDEX products_normalized_name ON products(company_id, normalized_name);

selectActiveBranches:
SELECT * FROM branches WHERE company_id = ? AND status = 'active' ORDER BY name;

selectActiveCategories:
SELECT c.*, (SELECT COUNT(*) FROM products p WHERE p.category_id = c.id AND p.status = 'active') AS product_count
FROM categories c WHERE c.company_id = ? AND c.status = 'active' ORDER BY c.name;

selectActiveProducts:
SELECT p.*, c.name AS category_name
FROM products p LEFT JOIN categories c ON p.category_id = c.id
WHERE p.company_id = ? AND p.status = 'active' ORDER BY p.name;

insertBranch:
INSERT INTO branches(company_id, name, address, phone, status, created_at) VALUES (?, ?, ?, ?, 'active', ?);

insertCategory:
INSERT INTO categories(company_id, name, description, status, created_at) VALUES (?, ?, ?, 'active', ?);

insertProduct:
INSERT INTO products(company_id, sku, barcode, name, normalized_name, category_id, cost_price, sell_price, tax_rate, unit, reorder_level, status, created_at, updated_at)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, 'active', ?, ?);

lastInsertRowId:
SELECT last_insert_rowid();

-- M4 data-preservation import (data-preservation-plan.md): explicit-id
-- variants, used ONLY by the legacy-database importer to preserve the
-- original row IDs every foreign-key relationship in the imported data
-- depends on. Never used by normal application code (which always lets
-- AUTOINCREMENT assign a fresh ID via insertBranch/insertCategory/
-- insertProduct above).
importBranch:
INSERT INTO branches(id, company_id, name, address, phone, status, created_at) VALUES (?, ?, ?, ?, ?, ?, ?);

importCategory:
INSERT INTO categories(id, company_id, name, description, status, created_at) VALUES (?, ?, ?, ?, 'active', ?);

importProduct:
INSERT INTO products(id, company_id, sku, barcode, name, normalized_name, category_id, cost_price, sell_price, tax_rate, unit, reorder_level, status, created_at, updated_at)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

-- M5.1 -- repository-foundation lookups/mutations. getById intentionally
-- ignores status (a caller may need to read an archived row, e.g. to
-- display it or reactivate it) -- only the list* queries above filter to
-- active.

selectCategoryById:
SELECT c.*, (SELECT COUNT(*) FROM products p WHERE p.category_id = c.id AND p.status = 'active') AS product_count
FROM categories c WHERE c.id = ? AND c.company_id = ?;

-- M5.8.15 -- real, case-sensitive exact-name lookup, matching the real
-- legacy `_handle_retail_categories` match rule exactly
-- (import-handler-matrix.md's own audit). Any status, not active-only --
-- a real archived Category must still be matched to avoid recreating it.
selectCategoryByExactName:
SELECT * FROM categories WHERE company_id = ? AND name = ?;

updateCategoryStatus:
UPDATE categories SET status = ? WHERE id = ? AND company_id = ?;

selectBranchById:
SELECT * FROM branches WHERE id = ? AND company_id = ?;

-- M5.8.15 -- real, case-sensitive exact-name lookup, matching the real
-- legacy `_handle_retail_branches` match rule exactly. Any status.
selectBranchByExactName:
SELECT * FROM branches WHERE company_id = ? AND name = ?;

updateBranchStatus:
UPDATE branches SET status = ? WHERE id = ? AND company_id = ?;

countActiveBranches:
SELECT COUNT(*) FROM branches WHERE company_id = ? AND status = 'active';

selectProductById:
SELECT p.*, c.name AS category_name
FROM products p LEFT JOIN categories c ON p.category_id = c.id
WHERE p.id = ? AND p.company_id = ?;

selectProductByBarcode:
SELECT p.*, c.name AS category_name
FROM products p LEFT JOIN categories c ON p.category_id = c.id
WHERE p.barcode = ? AND p.company_id = ? AND p.status = 'active';

-- M5.5.2 -- any-status barcode lookup for duplicate-detection at
-- create/update time only (never for scan lookup, which stays
-- active-only above) -- "do not allow an archived Product barcode to be
-- silently reused" (barcode-and-sku-contract.md).
selectProductByBarcodeAnyStatus:
SELECT * FROM products WHERE barcode = ? AND company_id = ?;

selectProductBySku:
SELECT p.*, c.name AS category_name
FROM products p LEFT JOIN categories c ON p.category_id = c.id
WHERE p.sku = ? AND p.company_id = ?;

updateProductStatus:
UPDATE products SET status = ?, updated_at = ? WHERE id = ? AND company_id = ?;

-- M5.5.3 -- optimistic concurrency: the WHERE clause requires the caller's
-- last-read updated_at to still match. changes() (SQLDelight's
-- transactionWithResult + this same connection) tells the caller whether
-- the row actually matched -- zero rows updated means either the product
-- doesn't exist/belongs to another company, or (far more commonly) someone
-- else updated it first -- UpdateProductUseCase disambiguates by re-reading
-- (product-domain-contract.md).
updateProduct:
UPDATE products
SET barcode = ?, name = ?, normalized_name = ?, category_id = ?, cost_price = ?, sell_price = ?, tax_rate = ?, unit = ?, reorder_level = ?, updated_at = ?
WHERE id = ? AND company_id = ? AND updated_at = ?;

changes:
SELECT changes();

-- M5.5.1 -- prefix search on the NFKC-normalized name, real-index-backed
-- (products_normalized_name). Substring/fuzzy search is explicitly out of
-- scope this milestone (would need SQLite FTS5, not proven necessary yet) --
-- product-domain-contract.md.
searchActiveProductsByNormalizedNamePrefix:
SELECT p.*, c.name AS category_name
FROM products p LEFT JOIN categories c ON p.category_id = c.id
WHERE p.company_id = ? AND p.status = 'active' AND p.normalized_name LIKE ? || '%'
ORDER BY p.normalized_name LIMIT ?;

-- M5.5.12 -- mirrors the legacy dashboard_stats low_stock query exactly
-- (retail_api.py:131-136, product-inventory-authority-audit.md #6) except
-- returning the actual rows, not just a count -- the legacy system never
-- had a route that listed them (low-stock-definition.md).
-- M5.5.5.14 follow-up -- real, durable audit trail for CatalogImporter's
-- deterministic barcode/SKU dedup pass (M5.5.15). Persisted, not just
-- returned in the transient CatalogImportResult, so "auditable migration
-- mapping" survives past the single import call that produced it --
-- product-migration-audit-report.md.
CREATE TABLE import_conflicts (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    company_id INTEGER NOT NULL,
    legacy_product_id INTEGER NOT NULL,
    field TEXT NOT NULL,
    original_value TEXT NOT NULL,
    resolution TEXT NOT NULL,
    canonical_product_id INTEGER,
    created_at INTEGER NOT NULL
);
CREATE INDEX import_conflicts_company_id ON import_conflicts(company_id);

insertImportConflict:
INSERT INTO import_conflicts(company_id, legacy_product_id, field, original_value, resolution, canonical_product_id, created_at)
VALUES (?, ?, ?, ?, ?, ?, ?);

selectImportConflicts:
SELECT * FROM import_conflicts WHERE company_id = ? ORDER BY id;

-- CatalogImporter-only: bulk, any-status read used to seed idempotency
-- (which legacy ids are already imported) and dedup state (which sku/
-- barcode values are already claimed) BEFORE processing new legacy rows --
-- without this, a partial-import-then-resume run could re-allow a
-- barcode/SKU already claimed by a row imported in an earlier partial run.
selectAllProductsForImportIdempotency:
SELECT id, sku, barcode FROM products WHERE company_id = ?;

selectLowStockProducts:
SELECT p.*, c.name AS category_name, COALESCE(b.qty, '0') AS total_on_hand
FROM products p
LEFT JOIN categories c ON p.category_id = c.id
LEFT JOIN (
    SELECT product_id, CAST(SUM(CAST(quantity_on_hand AS REAL)) AS TEXT) AS qty
    FROM inventory_balances WHERE company_id = ? GROUP BY product_id
) b ON p.id = b.product_id
WHERE p.company_id = ? AND p.status = 'active' AND CAST(COALESCE(b.qty, '0') AS REAL) <= p.reorder_level
ORDER BY p.name;
