-- M4 -- faithful port of the two lazily-created settings tables
-- (_ensure_credit_schema in the Python authority) -- declared as
-- first-class tables here from the start, no lazy-creation quirk carried
-- forward.

CREATE TABLE retail_settings (
    company_id INTEGER NOT NULL,
    skey TEXT NOT NULL,
    svalue TEXT NOT NULL,
    PRIMARY KEY (company_id, skey)
);

CREATE TABLE doc_sequences (
    company_id INTEGER NOT NULL,
    doc_type TEXT NOT NULL,
    last_no INTEGER NOT NULL DEFAULT 0,
    PRIMARY KEY (company_id, doc_type)
);

selectSetting:
SELECT svalue FROM retail_settings WHERE company_id = ? AND skey = ?;

selectAllSettings:
SELECT skey, svalue FROM retail_settings WHERE company_id = ?;

-- Real finding, this milestone's own build: SQLDelight's default dialect
-- (sqlite_3_18) rejects "ON CONFLICT ... DO UPDATE" (SQLite 3.24+ UPSERT
-- syntax). INSERT OR REPLACE is semantically identical here -- both tables'
-- only non-key column is being fully overwritten anyway, so a full-row
-- replace and a partial UPDATE produce the same result -- and needs no
-- dialect change.
upsertSetting:
INSERT OR REPLACE INTO retail_settings(company_id, skey, svalue) VALUES (?, ?, ?);

selectDocSequence:
SELECT last_no FROM doc_sequences WHERE company_id = ? AND doc_type = ?;

upsertDocSequence:
INSERT OR REPLACE INTO doc_sequences(company_id, doc_type, last_no) VALUES (?, ?, ?);
