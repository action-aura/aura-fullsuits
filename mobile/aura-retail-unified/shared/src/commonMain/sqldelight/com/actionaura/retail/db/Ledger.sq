-- M4 -- faithful port of schema.py's tax_rates/journal_entries/audit_log.

CREATE TABLE tax_rates (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    company_id INTEGER NOT NULL DEFAULT 1,
    name TEXT NOT NULL,
    rate TEXT NOT NULL,
    is_default INTEGER NOT NULL DEFAULT 0,
    created_at INTEGER NOT NULL
);
CREATE INDEX tax_rates_company_id ON tax_rates(company_id);

CREATE TABLE journal_entries (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    company_id INTEGER NOT NULL DEFAULT 1,
    reference TEXT,
    description TEXT,
    debit_account TEXT,
    credit_account TEXT,
    amount TEXT NOT NULL,
    entry_type TEXT,
    created_at INTEGER NOT NULL
);
CREATE INDEX journal_entries_company_id ON journal_entries(company_id);

CREATE TABLE audit_log (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    company_id INTEGER NOT NULL DEFAULT 1,
    user_id TEXT,
    action TEXT NOT NULL,
    entity TEXT,
    entity_id INTEGER,
    details TEXT,
    timestamp INTEGER NOT NULL
);
CREATE INDEX audit_log_company_id ON audit_log(company_id);
CREATE INDEX audit_log_entity ON audit_log(entity, entity_id);

selectTaxRates:
SELECT * FROM tax_rates WHERE company_id = ?;

insertAuditEntry:
INSERT INTO audit_log(company_id, user_id, action, entity, entity_id, details, timestamp)
VALUES (?, ?, ?, ?, ?, ?, ?);
