# Phase 9 -- staging secret template. NAMES ONLY. Copy to <repo-root>/.env.staging
# (gitignored, matches the .env* pattern), fill in real generated values, never commit.
# See docs/owner/phase9/secrets-and-key-management.md and secret-inventory-template.md.

STAGING_DOMAIN=staging.example.internal

STAGING_DB_USER=aura_owner_staging_app
STAGING_DB_PASSWORD=
STAGING_DB_NAME=aura_owner_staging

OWNER_SECRET_KEY=
OWNER_LICENSE_PEPPER=

# Required by owner/app/config.py's validate() for any OWNER_ENV that is not
# development/testing -- and docker-compose.staging.yml sets OWNER_ENV=staging.
# Without these three the owner container raises ConfigError and never starts,
# so they are part of the minimum template rather than tuning knobs.

# Comma-separated Host allowlist. Must include the hostname clients actually
# use -- normally the same value as STAGING_DOMAIN above. Empty accepts any
# Host header, which is why validate() refuses it.
OWNER_ALLOWED_HOSTS=staging.example.internal

# How many reverse proxies sit in front of this app. In this compose file that
# is Caddy, and only Caddy, so 1. Must be >=1: with 0 the X-Forwarded-* headers
# cannot be trusted for client IP or scheme, and validate() refuses to start.
OWNER_TRUSTED_PROXY_COUNT=1

# Where database backups are shipped. Must be a REMOTE URI -- validate()
# specifically rejects anything that looks like a local filesystem path,
# because a backup stored only on the host it is backing up is not a backup.
OWNER_BACKUP_TARGET_URL=s3://aura-owner-staging-backups/

# Leave unset/false until Milestone 13's staging-connected product builds
# and Milestone 12's real deployment are both actually ready -- do not
# enable the external licensing API before then.
OWNER_EXTERNAL_API_ENABLED=false
