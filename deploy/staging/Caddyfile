# Phase 9 -- staging reverse proxy config.
# {$STAGING_DOMAIN} is set via docker-compose.staging.yml's env_file
# (.env.staging, outside the repo -- see secrets-and-key-management.md).
# TLS: this file contains NO tls directive, so Caddy does the default thing
# and obtains a real Let's Encrypt certificate automatically as soon as
# {$STAGING_DOMAIN} resolves publicly to this host. That is what a real
# deployment wants, and it needs no change.
#
# Corrected 2026-09-13: this comment used to state that Caddy "is configured
# with `tls internal` to use its own local CA". It is not, and was not --
# `tls` appeared nowhere in this file except that sentence. The sentence
# described how one local-only session had been run, and then stayed here
# describing the file. Left uncorrected it misleads in both directions: an
# operator either believes their certificate is self-signed and goes looking
# for the problem, or helpfully "restores" the missing `tls internal` and
# breaks public TLS on the live host.
#
# If you DO want a local CA for a hosts-file-mapped name while testing, add
# `tls internal` inside the site block below -- and take it out again before
# the domain goes public.

{$STAGING_DOMAIN} {
	# Security headers (Milestone 4). CSP is intentionally permissive on
	# `unsafe-inline` style/script for the Owner UI's own first-party
	# templates only (no external script sources) -- tightened only after a
	# real CSP-violation-report drill against the real Owner UI, per the
	# governing instruction's own warning against an untested CSP breaking
	# required UI functionality.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Content-Security-Policy "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; frame-ancestors 'none'"
		-Server
	}

	encode gzip

	# Phase 9R M6: edge-level request-body ceiling as defense in depth,
	# slightly above the app's own MAX_CONTENT_LENGTH (12MB, app/config.py)
	# to allow for multipart boundary/header overhead -- rejects an
	# oversized request before it even reaches the app, rather than relying
	# solely on Flask's own check. Real bug found and fixed this milestone:
	# the app's global MAX_CONTENT_LENGTH used to be the licensing API's own
	# 64KB bound, which silently broke every expense attachment upload over
	# 64KB (production-postgresql.md's sibling doc,
	# request-body-limits.md, has the full root-cause).
	request_body {
		max_size 15MB
	}

	# Edge-level rate limiting is NOT enabled here: vanilla Caddy has no
	# built-in rate-limit directive (it requires the third-party
	# github.com/mholt/caddy-ratelimit plugin via a custom xcaddy build,
	# which this session does not build/verify -- see host-hardening.md's
	# honest disposition). Owner's own application-level login rate
	# limiting (Phase 4/8, real, tested) is the actually-verified control;
	# host-level fail2ban/ufw rate limiting is documented as a real
	# deployment requirement in firewall-and-network-policy.md.

	reverse_proxy owner:5000 {
		header_up X-Forwarded-Proto {scheme}
		health_uri /health/live
		health_interval 30s
		health_timeout 5s
	}
}
