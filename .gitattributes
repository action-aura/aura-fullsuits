# Normalize line endings so Windows (autocrlf=true) and macOS/Linux (autocrlf=false)
# clones never disagree about a file's bytes. Without this, aura-sync's
# auto-commit would see "changes" on every pass from CRLF/LF churn alone.
* text=auto eol=lf

# Windows-only scripts must keep CRLF (cmd.exe/PowerShell console tools expect it)
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# POSIX shell scripts must keep LF (shebang execution breaks with CRLF)
*.sh text eol=lf

# Binary — never diff, never normalize
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.jks binary
*.keystore binary
*.p12 binary
*.pfx binary
*.apk binary
*.aab binary
*.dump binary
*.zip binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.mp4 binary
*.mov binary
*.db binary
*.sqlite binary
*.sqlite3 binary
