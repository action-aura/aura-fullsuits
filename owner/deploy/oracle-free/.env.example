# Owner Control Center -- secrets/config template for the Oracle Cloud
# Always Free deployment (docker-compose.yml in this directory).
#
# Copy to `.env.oracle` IN THIS SAME DIRECTORY (owner/deploy/oracle-free/),
# next to docker-compose.yml -- NOT at the repo root. Docker Compose resolves
# every relative path written inside a Compose file (this file's `env_file:`
# and `./Caddyfile` mount) against the directory the Compose file itself
# lives in, regardless of the directory you run `docker compose` from. An
# earlier version of this comment said "repo root", which was wrong and
# would leave the app running with none of these values set (Compose fails
# loudly -- "env file not found" -- rather than silently, but it still costs
# a wasted round trip). NEVER commit the filled-in file. See
# docs/ops/free-hosting-owner.md for the full numbered walkthrough,
# including how to generate each secret.

# The public domain this VM answers on -- used by Caddy (for the automatic
# Let's Encrypt certificate). Point an A record at your Oracle VM's public IP
# before starting the stack, or Caddy cannot obtain a certificate.
#
# Deliberately NOT named OWNER_DOMAIN: every env var starting with "OWNER_"
# in this file is also injected into the `owner` container (both services
# share this one env_file), and OWNER_STRICT_CONFIG=true below makes
# config.py refuse to boot on any OWNER_* variable it doesn't recognize --
# proven locally 2026-09-23 (ConfigError: "unrecognized OWNER_* environment
# variable(s) (possible typo): OWNER_DOMAIN") before this variable was
# renamed to fix it. Only Caddy reads this one; keeping it off the OWNER_
# namespace keeps it out of that check for good, not just today.
SITE_DOMAIN=owner.example.com

# Flask/session secret. Generate with:
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
# config.py's validate() refuses to start without a real one (any value
# containing "insecure", or shorter than its minimum length, is rejected).
OWNER_SECRET_KEY=

# HMAC pepper for license-key secret hashing. Same generation command as
# above -- use a DIFFERENT random value, never reuse OWNER_SECRET_KEY.
OWNER_LICENSE_PEPPER=

# Neon Postgres connection string (https://console.neon.tech -- free
# project, see the runbook for exact steps). Neon requires TLS; append
# ?sslmode=require or the connection will be refused. Must start with
# postgresql:// or postgresql+psycopg:// -- config.py rejects anything else.
OWNER_DATABASE_URL=postgresql+psycopg://<user>:<pass>@<neon-host>/<db>?sslmode=require

# Comma-separated Host header allowlist. Must include SITE_DOMAIN above (kept
# as a separate variable, not reused, because env files can't expand one
# variable inside another), or every request 400s (config.py refuses an
# empty allowlist outside dev/test). THIS is the one config.py itself reads
# (OWNER_ALLOWED_HOSTS is in KNOWN_CONFIG_ENV_VARS; SITE_DOMAIN only feeds
# Caddy, see above).
OWNER_ALLOWED_HOSTS=owner.example.com

# Exactly one reverse proxy (Caddy) sits in front of this app in this
# compose file, so this is 1 -- not 0, not 2. Wrong values make X-Forwarded-*
# headers untrustworthy for client IP / scheme detection.
OWNER_TRUSTED_PROXY_COUNT=1

# THE LANDMINE (see docs/ops/free-hosting-owner.md and owner/deploy/fly/
# DEPLOY.md): unset or false, the app boots fine, /healthz returns 200, the
# admin UI works completely -- and the licensing, external-API and sync
# blueprints are never registered. No till can activate, check in, or sync.
# As of 2026-09-22 this is no longer silent -- a boot-time WARNING names it
# (app/__init__.py), /healthz's own "external_api_enabled" field reports it,
# and `flask commercial preflight` hard-FAILs on it -- but it is still much
# cheaper to get right here than to notice after the fact. Must be explicit
# true for this to be a working licensing authority.
OWNER_EXTERNAL_API_ENABLED=true
OWNER_EXTERNAL_API_BIND_HOST=0.0.0.0

# Enforced by config.py's validate_external_api_production() whenever the
# external API is on. Both PostgreSQL-backed (ADR-6.3), not Redis -- no
# separate service to run for these.
OWNER_REPLAY_PROTECTION_REQUIRED=true
OWNER_DISTRIBUTED_RATE_LIMIT_REQUIRED=true

# Where encrypted signing-key/Postgres backups are shipped. MUST be a remote
# URI (s3://, b2://, https://, ...) -- config.py specifically rejects a
# local filesystem path, because a backup that lives only on the host it is
# backing up is not a backup. Cloudflare R2 and Backblaze B2 both have free
# tiers large enough for this (a signing-key PEM is a few hundred bytes; a
# Postgres dump of this app's data is small). See the runbook's backup step
# -- this is NOT automated by anything in this compose file.
OWNER_BACKUP_TARGET_URL=

# The PUBLIC base URL tills sync through. For this deploy it is the same
# https://<SITE_DOMAIN>, with no path. If unset, activation silently omits
# sync_relay_base_url and tills never learn where to sync (found live
# 2026-10-10). bootstrap.sh refuses to continue while this is empty.
OWNER_SYNC_RELAY_PUBLIC_URL=https://owner.example.com

# Only one process runs in this compose file, so it owns the report-snapshot
# scheduler. If you ever scale to more than one `owner` replica, exactly one
# of them must keep this as "owner" and the rest must be "worker".
OWNER_SCHEDULER_ROLE=owner

# AUDIT 2026-09-24 gap G2. Read by run_scheduled_ops.sh (the systemd-timer
# job bundle this directory's bootstrap.sh installs -- see
# docs/ops/free-hosting-owner.md section 4.7) to pass `--currency` to
# `flask reports generate-scheduled`, which requires it. Deliberately NOT
# named OWNER_REPORT_CURRENCY -- same reasoning as SITE_DOMAIN above:
# OWNER_STRICT_CONFIG=true rejects any OWNER_*-prefixed variable Owner
# itself doesn't recognize, and this one is read by the shell wrapper, never
# by app/config.py. Change it if this deployment sells in a different
# currency; JOD matches this codebase's primary market (Jordan e-invoicing).
REPORT_CURRENCY=JOD

# Non-interactive first-admin bootstrap (see the runbook's verification
# step). Set only for the single `flask create-superadmin --non-interactive`
# run, then remove it from this file and rotate it -- never leave a
# long-lived bootstrap password sitting in an env file.
OWNER_BOOTSTRAP_PASSWORD=

# Rejects typo'd OWNER_* variables at boot (e.g. a misspelled security flag
# that would otherwise be silently ignored). Recommended true once this
# file's variables are finalized.
OWNER_STRICT_CONFIG=true

# Website demo-request intake (POST /api/intake/website-lead). Unset or empty
# == the route answers 404 (off). Generate a value WITHOUT printing it, see
# docs; it must be at least 32 chars or config.py refuses to start. The SAME
# value is set on the website as the Pages secret OWNER_INTAKE_SECRET.
OWNER_WEBSITE_INTAKE_SECRET=
