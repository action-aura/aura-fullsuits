# Aura Owner -- local development environment template.
# Copy to .env and fill in real values. NEVER commit a real .env file.

OWNER_ENV=development

# Flask/session secret -- required in non-development environments (app.config.validate()).
OWNER_SECRET_KEY=

# PostgreSQL connection (SQLAlchemy 2.x + psycopg3 URL form).
OWNER_DATABASE_URL=postgresql+psycopg://aura_owner:aura_owner_dev@db:5432/aura_owner_dev
OWNER_TEST_DATABASE_URL=postgresql+psycopg://aura_owner:aura_owner_dev@db:5432/aura_owner_test
# Deploying against a managed cloud Postgres (Neon, Supabase, etc. -- see
# docs/ops/free-hosting-owner.md) instead of the local `db` container above?
# Those require TLS and refuse a plain connection -- append ?sslmode=require
# to the URL, e.g.:
#   OWNER_DATABASE_URL=postgresql+psycopg://user:pass@host/db?sslmode=require
# config.py's validate() only checks the postgresql:// / postgresql+psycopg://
# prefix, so the query string passes through untouched either way.

# HMAC pepper for license-key secret hashing (Part O). Required in non-development environments.
OWNER_LICENSE_PEPPER=

# Session lifetimes (seconds).
OWNER_SESSION_ABSOLUTE_SECONDS=28800
OWNER_SESSION_IDLE_SECONDS=1800
OWNER_RECENT_AUTH_SECONDS=600

# Login throttling.
OWNER_LOGIN_MAX_ATTEMPTS=5
OWNER_LOGIN_LOCKOUT_SECONDS=900

# External product-integration / Licensing & Activation API (Phase 6) --
# MUST remain false outside a throwaway dev sandbox or a deliberately
# configured pilot; no route is even registered when false (Part B/R).
OWNER_EXTERNAL_API_ENABLED=false
OWNER_EXTERNAL_API_BIND_HOST=127.0.0.1
OWNER_EXTERNAL_API_ALLOWED_CONTRACTS=v1

# Server Ed25519 signing keys (Phase 6, Part I). Directory holding PEM private
# key files -- NEVER committed, NEVER in the database. Must exist and contain
# an ACTIVE key (via `flask licensing generate-signing-key` +
# `activate-signing-key`) before the external API can serve any request.
OWNER_SIGNING_KEY_DIRECTORY=/app/var/signing-keys

# Replay protection and distributed rate limiting (Phase 6, Parts L/M) are
# PostgreSQL-backed, not Redis (ADR-6.3 in docs/owner/phase6) -- no separate
# service to configure here. Both MUST stay true whenever the external API is
# enabled outside development; config.py refuses to start otherwise.
OWNER_REPLAY_PROTECTION_REQUIRED=true
OWNER_DISTRIBUTED_RATE_LIMIT_REQUIRED=true

# Activation protocol tuning (Phase 6, Parts L/H/P).
OWNER_ACTIVATION_TIMESTAMP_SKEW_SECONDS=300
OWNER_NONCE_TTL_SECONDS=600
OWNER_ASSERTION_TTL_SECONDS=86400
OWNER_DEFAULT_OFFLINE_GRACE_SECONDS=1209600
OWNER_MAX_REQUEST_BYTES=65536

# Where Owner PostgreSQL backups are written (Part Y).
OWNER_BACKUP_DIR=/app/var/backups

# Directory containing pg_dump/pg_restore if not already on PATH.
OWNER_PG_BIN_DIR=

# Only used for the non-interactive `flask create-superadmin --non-interactive`
# bootstrap path (e.g. scripted first-time setup). Never set this in a
# long-lived environment file.
OWNER_BOOTSTRAP_PASSWORD=

# -- Phase 9R M2: environment separation --
# How many reverse-proxy hops to trust for X-Forwarded-* headers. Required
# >=1 in staging/production once Caddy (M6) is in front of the app; 0 is
# correct for local development (no proxy).
OWNER_TRUSTED_PROXY_COUNT=0

# Comma-separated Host header allowlist. Required non-empty in staging/
# production. Example: owner-staging.example.com,owner.example.com
OWNER_ALLOWED_HOSTS=

# Where encrypted backups are shipped (M12) -- must be a remote URI
# (s3://, b2://, https://, ...), never a local path. Required in staging/
# production.
OWNER_BACKUP_TARGET_URL=

# Exactly one process per environment sets this to "owner" (runs the
# report-snapshot scheduler); every other process (every Gunicorn worker)
# leaves it at the default "worker". Required explicit in staging/
# production so scheduler ownership is never ambiguous.
OWNER_SCHEDULER_ROLE=worker

# When true, startup fails if any OWNER_* environment variable is set that
# this app doesn't recognize (typo detection). Recommended true in staging/
# production once your deployment's env vars are finalized.
OWNER_STRICT_CONFIG=false

# Owner's own outbound email (staff invitations, staff password reset, and the
# mail relay installed products use -- products never hold a mailbox
# password). OWNER_SMTP_HOST unset == email is off: nothing breaks, mail just
# stays queued and the UI says email is not set up. The password belongs in
# this server's environment only (never in the repo or a database).
# Prove it works with:  flask email send-test --to you@example.com
OWNER_SMTP_HOST=
OWNER_SMTP_PORT=587
OWNER_SMTP_USER=
OWNER_SMTP_PASSWORD=
# Defaults to OWNER_SMTP_USER
OWNER_SMTP_FROM=
OWNER_SMTP_FROM_NAME=Action Aura
# 1 == STARTTLS (the certificate is verified); 0 only for a local debug relay
OWNER_SMTP_USE_TLS=1

# Manager push notifications (Step 1, app/push/): a seller records a sale ->
# the phones of the managers who may confirm it get a notification.
# Unset == OFF: no thread, no outbox rows, no "turn on" button, /push/* 404.
# Make the key with `flask notifications generate-vapid-keys >> .env` (it
# refuses to print the private key to a terminal). Never commit it.
OWNER_PUSH_VAPID_PRIVATE_KEY=
OWNER_PUSH_VAPID_SUBJECT=mailto:info@actionaura.me

# --- Customer website accounts (Step 2 CA1) -- ALL OFF unless set ---------------
# Staff screens ("Website account" panel, branch name): true to switch on.
# OWNER_CUSTOMER_ACCOUNTS_ENABLED=false
# The website address every invitation / reset link is built from (never the
# request Host). Required before an account can be created.
# OWNER_CUSTOMER_PORTAL_BASE_URL=https://actionaura.me
# Shared secret with the website (HMAC). Unset or a placeholder: the website API
# answers 404. Two slots so it can be rotated: add the new one as slot 2, move the
# website to it, then retire slot 1. Generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
# OWNER_WEBSITE_ACCOUNT_KEY_ID=k1
# OWNER_WEBSITE_ACCOUNT_SECRET=
# OWNER_WEBSITE_ACCOUNT_KEY_ID_2=k2
# OWNER_WEBSITE_ACCOUNT_SECRET_2=
# Customer mail: sender (default OWNER_SMTP_FROM) and Reply-To (default: none).
# OWNER_CUSTOMER_MAIL_FROM=noreply@actionaura.me
# OWNER_CUSTOMER_MAIL_REPLY_TO=
