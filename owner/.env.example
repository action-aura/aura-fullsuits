# Aura Owner -- local development environment template.
# Copy to .env and fill in real values. NEVER commit a real .env file.

OWNER_ENV=development

# Flask/session secret -- required in non-development environments (app.config.validate()).
OWNER_SECRET_KEY=

# PostgreSQL connection (SQLAlchemy 2.x + psycopg3 URL form).
OWNER_DATABASE_URL=postgresql+psycopg://aura_owner:aura_owner_dev@db:5432/aura_owner_dev
OWNER_TEST_DATABASE_URL=postgresql+psycopg://aura_owner:aura_owner_dev@db:5432/aura_owner_test

# HMAC pepper for license-key secret hashing (Part O). Required in non-development environments.
OWNER_LICENSE_PEPPER=

# Session lifetimes (seconds).
OWNER_SESSION_ABSOLUTE_SECONDS=28800
OWNER_SESSION_IDLE_SECONDS=1800
OWNER_RECENT_AUTH_SECONDS=600

# Login throttling.
OWNER_LOGIN_MAX_ATTEMPTS=5
OWNER_LOGIN_LOCKOUT_SECONDS=900

# External product-integration / Licensing & Activation API (Phase 6) --
# MUST remain false outside a throwaway dev sandbox or a deliberately
# configured pilot; no route is even registered when false (Part B/R).
OWNER_EXTERNAL_API_ENABLED=false
OWNER_EXTERNAL_API_BIND_HOST=127.0.0.1
OWNER_EXTERNAL_API_ALLOWED_CONTRACTS=v1

# Server Ed25519 signing keys (Phase 6, Part I). Directory holding PEM private
# key files -- NEVER committed, NEVER in the database. Must exist and contain
# an ACTIVE key (via `flask licensing generate-signing-key` +
# `activate-signing-key`) before the external API can serve any request.
OWNER_SIGNING_KEY_DIRECTORY=/app/var/signing-keys

# Replay protection and distributed rate limiting (Phase 6, Parts L/M) are
# PostgreSQL-backed, not Redis (ADR-6.3 in docs/owner/phase6) -- no separate
# service to configure here. Both MUST stay true whenever the external API is
# enabled outside development; config.py refuses to start otherwise.
OWNER_REPLAY_PROTECTION_REQUIRED=true
OWNER_DISTRIBUTED_RATE_LIMIT_REQUIRED=true

# Activation protocol tuning (Phase 6, Parts L/H/P).
OWNER_ACTIVATION_TIMESTAMP_SKEW_SECONDS=300
OWNER_NONCE_TTL_SECONDS=600
OWNER_ASSERTION_TTL_SECONDS=86400
OWNER_DEFAULT_OFFLINE_GRACE_SECONDS=1209600
OWNER_MAX_REQUEST_BYTES=65536

# Where Owner PostgreSQL backups are written (Part Y).
OWNER_BACKUP_DIR=/app/var/backups

# Directory containing pg_dump/pg_restore if not already on PATH.
OWNER_PG_BIN_DIR=

# Only used for the non-interactive `flask create-superadmin --non-interactive`
# bootstrap path (e.g. scripted first-time setup). Never set this in a
# long-lived environment file.
OWNER_BOOTSTRAP_PASSWORD=
