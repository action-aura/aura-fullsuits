{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aura-owner.internal/contracts/license-check-request-v1.schema.json",
  "title": "License Check Request v1",
  "description": "INACTIVE specification only (Part R).",
  "type": "object",
  "additionalProperties": false,
  "required": ["product_code", "platform", "installation_id", "timestamp", "request_nonce", "contract_version"],
  "properties": {
    "product_code": { "type": "string", "enum": ["AURA_RETAIL", "AURA_CLINIC"] },
    "platform": { "type": "string", "enum": ["WINDOWS", "ANDROID"] },
    "app_version": { "type": "string" },
    "release_channel": { "type": "string" },
    "installation_id": { "type": "string", "format": "uuid" },
    "timestamp": { "type": "string", "format": "date-time" },
    "request_nonce": { "type": "string" },
    "contract_version": { "type": "string", "const": "v1" }
  }
}
