{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aura-owner.internal/contracts/license-check-response-v1.schema.json",
  "title": "License/Installation Check-In Response v1",
  "description": "LIVE as of Phase 6. Matches app/licensing_service/checkin.py's response dict.",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "response_id", "correlation_id", "server_timestamp", "result", "reason_code", "decision"],
  "properties": {
    "contract_version": { "type": "string", "const": "v1" },
    "response_id": { "type": "string" },
    "correlation_id": { "type": ["string", "null"] },
    "server_timestamp": { "type": "string", "format": "date-time" },
    "result": { "type": "string", "enum": ["SUCCESS", "FAILURE"] },
    "reason_code": { "type": "string" },
    "decision": { "type": "string", "enum": ["APPROVED", "REJECTED"] },
    "signed_assertion": { "type": "object", "description": "Present only on SUCCESS -- a freshly issued assertion, refreshed on every successful check-in." },
    "signing_key_id": { "type": "string" },
    "assertion_version": { "type": "integer" }
  }
}
