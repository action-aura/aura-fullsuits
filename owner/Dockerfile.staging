# Phase 9 Milestone 3 -- hardened staging image.
# Differences from the existing dev owner/Dockerfile (intentional, not
# accidental drift):
#   - requirements/owner-server.txt only (no requirements/development.txt --
#     no pytest/coverage/linters/dev tooling shipped in the staging image).
#   - runs as a dedicated non-root user.
#   - OWNER_ENV=staging, not "production" (Non-Negotiable Principle 2:
#     staging must be clearly labeled as staging, never claim to be
#     production).
#   - a real HEALTHCHECK against the new /health/ready endpoint.
FROM python:3.11-slim

# pg_dump (System -> Backup) must be >= the database server's major version or
# it refuses with "server version mismatch". Debian trixie's own
# postgresql-client is 17 while Neon runs 18, so the in-app backup button could
# never work (found by the 2026-10-10 live-deploy audit). Take the client from
# the official PGDG repo, pinned to major 18: BUMP THIS when Neon moves to a
# newer major (backup.py also refuses, with a clear message, if it is behind).
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl gnupg \
    && install -d /usr/share/postgresql-common/pgdg \
    && curl -fsSL -o /usr/share/postgresql-common/pgdg/apt.postgresql.org.asc https://www.postgresql.org/media/keys/ACCC4CF8.asc \
    && . /etc/os-release \
    && echo "deb [signed-by=/usr/share/postgresql-common/pgdg/apt.postgresql.org.asc] https://apt.postgresql.org/pub/repos/apt ${VERSION_CODENAME}-pgdg main" > /etc/apt/sources.list.d/pgdg.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends postgresql-client-18 \
    && apt-get purge -y --auto-remove gnupg \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --system aura && useradd --system --gid aura --home /app --shell /usr/sbin/nologin aura

WORKDIR /app

COPY requirements/base.txt requirements/owner-server.txt /app/requirements/
RUN pip install --no-cache-dir -r requirements/owner-server.txt

COPY owner/ /app/owner/
# expense-attachments + release-artifacts: compose mounts named volumes here
# (oracle-free); a new volume only inherits aura ownership on first mount if
# the directory exists in the image with that owner, hence created here too.
RUN mkdir -p /app/owner/var/signing-keys /app/owner/var/backups \
    /app/owner/var/expense-attachments /app/owner/var/release-artifacts \
    && chown -R aura:aura /app

WORKDIR /app/owner
USER aura

ENV FLASK_APP=app:create_app
ENV OWNER_ENV=staging
ENV PYTHONUNBUFFERED=1

EXPOSE 5000

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD curl -fsS http://127.0.0.1:5000/health/live || exit 1

# 2 workers / 4 threads: appropriate for a small supervised pilot on a
# single small host, not a claim of internet scale. --max-requests recycles
# workers periodically as a defense against slow memory growth going
# unnoticed on an unattended staging host. --timeout bounds a single
# request's worst case so one stuck request can't wedge a whole worker.
CMD ["gunicorn", "--bind", "0.0.0.0:5000", "--workers", "2", "--threads", "4", \
     "--timeout", "30", "--graceful-timeout", "15", "--max-requests", "2000", \
     "--max-requests-jitter", "200", "--access-logfile", "-", "--error-logfile", "-", \
     "app:create_app()"]
