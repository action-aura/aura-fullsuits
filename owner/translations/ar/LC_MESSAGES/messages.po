#: app/i18n_labels.py:358
#, python-format
msgid ""
"Subscription must already be in PILOT status to create a pilot record "
"(was %(current_status)s)."
msgstr ""
"يجب أن يكون الاشتراك في حالة PILOT بالفعل لإنشاء سجل تجربة تشغيلية (كانت "
"الحالة %(current_status)s)."

#: app/i18n_labels.py:359
msgid "Pilot end date must be after the pilot start date."
msgstr "يجب أن يكون تاريخ انتهاء التجربة التشغيلية بعد تاريخ بدايتها."

#: app/i18n_labels.py:360
msgid "A reason is required to extend a pilot."
msgstr "يلزم إدخال سبب لتمديد التجربة التشغيلية."

#: app/i18n_labels.py:361
#, python-format
msgid ""
"Pilot has already been extended %(count)s time(s) (maximum allowed: "
"%(max)s). No indefinite rolling pilot."
msgstr ""
"تم تمديد التجربة التشغيلية %(count)s مرة/مرات بالفعل (الحد الأقصى المسموح"
" به: %(max)s) -- لا يُسمح بتمديد التجربة إلى ما لا نهاية."

#: app/i18n_labels.py:362
msgid "The new end date must be after the current pilot end date."
msgstr ""
"يجب أن يكون تاريخ الانتهاء الجديد بعد تاريخ انتهاء التجربة الحالي.يجب أن "
"يكون تاريخ الانتهاء الجديد بعد تاريخ انتهاء التجربة التشغيلية الحالي."

#: app/i18n_labels.py:363
msgid ""
"The renewal request must be applied before this pilot can be marked "
"converted."
msgstr "يجب تطبيق طلب التجديد قبل أن يتسنى تعليم هذه التجربة التشغيلية كمُحوَّلة."

#: app/i18n_labels.py:364
msgid "This renewal request does not belong to this pilot's subscription."
msgstr "طلب التجديد هذا لا يخص اشتراك هذه التجربة التشغيلية."

#: app/i18n_labels.py:365
msgid "A reason is required to cancel a pilot."
msgstr "يلزم إدخال سبب لإلغاء التجربة التشغيلية."

#: app/i18n_labels.py:375
#, python-format
msgid "Cannot change the pilot status from %(from_status)s to %(to_status)s."
msgstr "لا يمكن تغيير حالة التجربة التشغيلية من %(from_status)s إلى %(to_status)s."

#: app/i18n_labels.py:376
#, python-format
msgid "Cannot extend a pilot in status %(status)s."
msgstr "لا يمكن تمديد تجربة تشغيلية في حالة %(status)s."

#: app/i18n_labels.py:377
#, python-format
msgid "Cannot convert a pilot in status %(status)s."
msgstr "لا يمكن تحويل تجربة تشغيلية في حالة %(status)s."

#: app/i18n_labels.py:388
#, python-format
msgid ""
"Cannot change the renewal request status from %(from_status)s to "
"%(to_status)s."
msgstr "لا يمكن تغيير حالة طلب التجديد من %(from_status)s إلى %(to_status)s."

#: app/i18n_labels.py:389
msgid "Use the approve action to move this renewal request to Approved."
msgstr "استخدم إجراء الاعتماد لنقل طلب التجديد هذا إلى حالة معتمد."

#: app/i18n_labels.py:390
#, python-format
msgid "Cannot approve a renewal request in status %(status)s."
msgstr "لا يمكن اعتماد طلب تجديد في حالة %(status)s."

#: app/i18n_labels.py:391
#, python-format
msgid ""
"Cannot apply a renewal request in status %(status)s; it must be Approved "
"first."
msgstr "لا يمكن تطبيق طلب تجديد في حالة %(status)s؛ يجب أن يكون معتمدًا أولاً."

#: app/i18n_labels.py:402
msgid "A reason is required to release a device slot."
msgstr "يلزم إدخال سبب لتحرير فتحة الجهاز."

#: app/i18n_labels.py:403
msgid "A reason is required to replace a device slot."
msgstr "يلزم إدخال سبب لاستبدال فتحة الجهاز."

#: app/i18n_labels.py:404
msgid "Extra slots must be a positive number."
msgstr "يجب أن يكون عدد الفتحات الإضافية رقمًا موجبًا."

#: app/i18n_labels.py:405
msgid "A reason is required to create a device slot exception."
msgstr "يلزم إدخال سبب لإنشاء استثناء فتحة جهاز."

#: app/i18n_labels.py:406
msgid "The expiry date must be after the start date."
msgstr "يجب أن يكون تاريخ الانتهاء بعد تاريخ البدء."

#: app/i18n_labels.py:407
#, python-format
msgid ""
"Device slot exceptions may not exceed %(max_days)s days -- temporary "
"means temporary."
msgstr ""
"لا يجوز أن تتجاوز استثناءات فتحات الأجهزة %(max_days)s يومًا -- فالمؤقت "
"يعني مؤقتًا."

#: app/i18n_labels.py:408
#, python-format
msgid "Cannot revoke a device slot exception in status %(status)s."
msgstr "لا يمكن إلغاء استثناء فتحة جهاز في حالة %(status)s."

#: app/i18n_labels.py:409
msgid "A reason is required to revoke a device slot exception."
msgstr "يلزم إدخال سبب لإلغاء استثناء فتحة الجهاز."

#: app/i18n_labels.py:419
msgid "A reason is required to create an emergency extension."
msgstr "يلزم إدخال سبب لإنشاء تمديد طوارئ."

#: app/i18n_labels.py:420
#, python-format
msgid ""
