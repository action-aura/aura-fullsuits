msgstr "يجب أن تكون المدة بين 1 و%(max_hours)s ساعة (صريحة وقصيرة الأجل فقط)."

#: app/i18n_labels.py:325
msgid "Cannot create an emergency extension for a revoked license."
msgstr "لا يمكن إنشاء تمديد طوارئ لترخيص مُلغى."

#: app/i18n_labels.py:326
#, python-format
